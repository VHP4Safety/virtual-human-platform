# Corrections of the targets of the official Bioschemas shapes (vocabularies/bioschemas-profiles-99beab9.shacl).
# The official shapes are used as published. Both files are used in the checks.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix bioschemas: <https://bioschemas.org/terms/> .
@prefix bioschemas_draft: <https://bioschemas.org/draft_terms/> .

# In the official file, the targets of these profiles are classes at discovery.biothings.io. These classes are not
# used in records.
<https://bioschemas.org/profiles/LabProtocol/0.8-DRAFT> sh:targetClass bioschemas_draft:LabProtocol .
<https://bioschemas.org/profiles/Study/0.3-DRAFT> sh:targetClass bioschemas_draft:Study .

# In the official file, the target of this profile is schema:FormalParameter. The Bioschemas class is used in records.
<https://bioschemas.org/profiles/FormalParameter/1.0-RELEASE> sh:targetClass bioschemas:FormalParameter .

# In the official file, the targets of these draft profiles are parent classes (BioChemEntity for ProteinStructure,
# CreativeWork for SemanticTextAnnotation). The profiles are switched off, as no record is a protein structure or a
# text annotation.
<https://bioschemas.org/profiles/ProteinStructure/0.6-DRAFT> sh:deactivated true .
<https://bioschemas.org/profiles/SemanticTextAnnotation/0.3-DRAFT> sh:deactivated true .
