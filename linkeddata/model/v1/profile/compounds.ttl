@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix form: <https://platform.vhp4safety.nl/model/v1/form#> .

form:Compound a sh:NodeShape ;
    form:path "compound" ; sh:order 15 ;
    sh:targetClass schema:MolecularEntity ;
    rdfs:label "Compound" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:severity sh:Warning ; sh:message "Add the name, as Bioschemas asks." ] ;
    sh:property [ sh:path schema:alternateName ; sh:order 2 ; sh:name "Other names" ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:order 3 ; sh:name "Description" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:identifier ; sh:order 4 ; sh:name "Identifiers" ; sh:minCount 1 ;
        sh:class schema:PropertyValue ; sh:node form:Identifier ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add an identifier, as Bioschemas asks." ] ;
    sh:property [ sh:path schema:inChI ; sh:order 5 ; sh:name "InChI" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:inChIKey ; sh:order 6 ; sh:name "InChIKey" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:smiles ; sh:order 7 ; sh:name "SMILES" ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:molecularFormula ; sh:order 8 ; sh:name "Molecular formula" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:molecularWeight ; sh:order 9 ; sh:name "Molecular weight (g/mol)" ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 10 ; sh:name "Addresses elsewhere" ; sh:nodeKind sh:IRI ;
        sh:description "Such as its Compound Wiki, Wikidata or glossary entry." ] .

form:Identifier a sh:NodeShape ;
    sh:targetClass schema:PropertyValue ;
    rdfs:label "Identifier or value" ;
    sh:property [ sh:path schema:propertyID ; sh:order 1 ; sh:name "Identifier type" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:value ; sh:order 2 ; sh:name "Identifier value" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
