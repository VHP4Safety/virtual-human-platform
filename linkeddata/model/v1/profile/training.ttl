@prefix schema: <https://schema.org/> .
@prefix bioschemas_draft: <https://bioschemas.org/draft_terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix form: <https://platform.vhp4safety.nl/model/v1/form#> .

form:LearningResource a sh:NodeShape ;
    form:path "training" ; sh:order 14 ;
    sh:targetClass schema:LearningResource ;
    dct:conformsTo <https://bioschemas.org/profiles/TrainingMaterial/1.0-RELEASE> ;
    rdfs:label "Training material" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] ;
    sh:property [ sh:path schema:keywords ; sh:order 3 ; sh:name "Keywords" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it; text is kept until then." ] ;
    sh:property [ sh:path schema:learningResourceType ; sh:order 4 ; sh:name "Kind of material" ; sh:datatype xsd:string ; sh:severity sh:Warning ;
        sh:in ( "tutorial" "video" "course" "slides" "notebook" "handout" "e-learning" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path schema:mentions ; sh:order 5 ; sh:name "Tools and methods taught" ; sh:minCount 1 ; sh:severity sh:Warning ;
        sh:or ( [ sh:class schema:SoftwareApplication ; rdfs:label "Tool" ] [ sh:class bioschemas_draft:LabProtocol ; rdfs:label "Method" ] [ sh:class schema:Dataset ; rdfs:label "Data" ] [ sh:class schema:SoftwareSourceCode ; rdfs:label "Model" ] ) ;
        sh:message "Link the tools, methods, data or models it teaches." ] ;
    sh:property [ sh:path schema:about ; sh:order 6 ; sh:name "Topics" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose an ontology term, or register it." ; sh:description "What it is about, such as EDAM topics." ] ;
    sh:property [ sh:path schema:url ; sh:order 7 ; sh:name "Address" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "Where the material is read or watched." ] ;
    sh:property [ sh:path schema:license ; sh:order 8 ; sh:name "License" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ; sh:pattern "^https://spdx\\.org/licenses/" ; form:publishedAs schema:CreativeWork ; sh:message "Add the license, chosen from SPDX; other values are kept." ] ;
    sh:property [ sh:path schema:inLanguage ; sh:order 9 ; sh:name "Language" ; sh:datatype xsd:string ;
        sh:description "An IETF BCP 47 code, such as en; English when none is given." ] ;
    sh:property [ sh:path schema:timeRequired ; sh:order 10 ; sh:name "Time required" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^P" ;
        sh:description "An ISO 8601 duration, such as PT1H30M." ] ;
    sh:property [ sh:path schema:educationalLevel ; sh:order 11 ; sh:name "Level" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:severity sh:Warning ;
        sh:in ( "Beginner" "Intermediate" "Advanced" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path schema:teaches ; sh:order 12 ; sh:name "Learning outcomes" ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:competencyRequired ; sh:order 13 ; sh:name "Prerequisites" ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:author ; sh:order 14 ; sh:name "Authors" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ] ;
    sh:property [ sh:path schema:datePublished ; sh:order 15 ; sh:name "Published" ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path schema:dateModified ; sh:order 16 ; sh:name "Last changed" ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path schema:hasPart ; sh:order 17 ; sh:name "Sections and files" ; sh:nodeKind sh:BlankNode ;
        sh:or ( [ sh:class schema:WebPageElement ; sh:node form:WebPageElement ; rdfs:label "Section" ] [ sh:class schema:DigitalDocument ; sh:node form:DigitalDocument ; rdfs:label "File" ] ) ;
        sh:description "Its sections where they are read, and its files, such as slides, notebooks and scripts." ] ;
    sh:property [ sh:path schema:video ; sh:order 18 ; sh:name "Video" ; sh:maxCount 1 ; sh:class schema:VideoObject ; sh:node form:VideoObject ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path schema:isPartOf ; sh:order 19 ; sh:name "Part of" ; sh:class schema:Course ; sh:description "The course it belongs to." ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 20 ; sh:name "DOI and other addresses" ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path dct:conformsTo ; sh:order 21 ; sh:name "Conforms to" ; sh:minCount 1 ; sh:nodeKind sh:IRI ; sh:severity sh:Warning ;
        sh:message "Add the Bioschemas profile it follows, as Bioschemas asks." ;
        sh:description "Its Bioschemas profile, and the documentation format it follows, if any." ] .

form:Course a sh:NodeShape ;
    sh:targetClass schema:Course ;
    dct:conformsTo <https://bioschemas.org/profiles/Course/1.0-RELEASE> ;
    rdfs:label "Course" ;
    sh:node form:LearningResource ;
    sh:property [ sh:path schema:provider ; sh:order 22 ; sh:name "Provider" ;
        sh:or ( [ sh:class schema:Organization ; rdfs:label "Organisation" ] [ sh:class schema:Person ; rdfs:label "Person" ] ) ] ;
    sh:property [ sh:path schema:coursePrerequisites ; sh:order 23 ; sh:name "Prerequisites of the course" ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:hasCourseInstance ; sh:order 24 ; sh:name "Given" ; sh:class schema:CourseInstance ; sh:node form:CourseInstance ; sh:nodeKind sh:BlankNode ;
        sh:description "Each time the course was given, with its dates and place." ] .

form:CourseInstance a sh:NodeShape ;
    sh:targetClass schema:CourseInstance ;
    dct:conformsTo <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE> ;
    rdfs:label "Course given" ;
    sh:property [ sh:path schema:startDate ; sh:order 1 ; sh:name "From" ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path schema:endDate ; sh:order 2 ; sh:name "Until" ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path schema:location ; sh:order 3 ; sh:name "Place" ; sh:datatype xsd:string ] .

form:DigitalDocument a sh:NodeShape ;
    sh:targetClass schema:DigitalDocument ;
    rdfs:label "File" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:url ; sh:order 2 ; sh:name "Address" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "The file's address needed." ] .
