@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix form: <https://platform.vhp4safety.nl/model/v1/form#> .

form:WebPageElement a sh:NodeShape ;
    sh:targetClass schema:WebPageElement ;
    rdfs:label "Section" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Heading" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:text ; sh:order 2 ; sh:name "Text" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:position ; sh:order 3 ; sh:name "Position" ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path schema:image ; sh:order 4 ; sh:name "Figures" ; sh:class schema:ImageObject ; sh:node form:ImageObject ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:description "Shown after the text." ] ;
    sh:property [ sh:path schema:video ; sh:order 5 ; sh:name "Videos" ; sh:class schema:VideoObject ; sh:node form:VideoObject ; sh:nodeKind sh:BlankNodeOrIRI ] ;
    sh:property [ sh:path schema:creativeWorkStatus ; sh:order 6 ; sh:name "Status" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:in ( "hidden" ) ;
        sh:description "Empty: the section is shown. hidden: the section is kept in the data, but not shown on the page." ] ;
    sh:property [ sh:path schema:hasPart ; sh:order 7 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:description "Its own sections, shown as its items." ] ;
    sh:property [ sh:path schema:about ; sh:order 8 ; sh:name "Presents" ; sh:maxCount 1 ;
        sh:or ( [ sh:class schema:MonetaryGrant ; rdfs:label "Grant" ] [ sh:class schema:Organization ; rdfs:label "Organisation or project" ] [ sh:class schema:LearningResource ; rdfs:label "Training material" ] ) ;
        sh:description "The record that is presented in the section, with the shown fields. Or, for a grant without shown fields, the records that name the grant, such as its publications." ] ;
    sh:property [ sh:path form:shows ; sh:order 10 ; sh:name "Shows" ; sh:nodeKind sh:IRI ; sh:severity sh:Warning ;
        sh:in ( schema:description schema:text schema:image schema:video schema:subjectOf schema:subOrganization schema:member schema:funding schema:funder schema:amount schema:identifier ) ;
        sh:message "Choose from the list. Other values are kept." ;
        sh:description "The fields of the presented record that are shown in the section, such as its description or its research lines." ] ;
    sh:property [ sh:path schema:url ; sh:order 9 ; sh:name "Address" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "Where the section is read, such as a section of a tutorial on the documentation site." ] .

form:ImageObject a sh:NodeShape ;
    sh:targetClass schema:ImageObject ;
    rdfs:label "Figure" ;
    sh:property [ sh:path schema:contentUrl ; sh:order 1 ; sh:name "Image" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "One image address needed." ] ;
    sh:property [ sh:path schema:caption ; sh:order 2 ; sh:name "Caption" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "Also read out in place of the image." ] .

form:WebPage a sh:NodeShape ;
    form:path "pages" ; sh:order 8 ;
    sh:targetClass schema:WebPage ;
    rdfs:label "Page" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:url ; sh:order 3 ; sh:name "Address elsewhere" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:about ; sh:order 4 ; sh:name "Terms explained" ; sh:class schema:DefinedTerm ;
        sh:description "A term with kinds that are explained on the page, such as Process Flow Step." ] ;
    sh:property [ sh:path schema:hasPart ; sh:order 5 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNodeOrIRI ;
        sh:description "Sections of a platform page, each with a heading, a text and a position. The sections of a section are its items." ] .

form:AboutPage a sh:NodeShape ;
    sh:targetClass schema:AboutPage ;
    sh:node form:WebPage ;
    rdfs:label "About page" ;
    sh:property [ sh:path schema:mainEntity ; sh:order 6 ; sh:name "About" ; sh:maxCount 1 ; sh:class schema:Organization ;
        sh:description "Its description, videos, figures, research lines, grants and partners are shown, and the publications of its grants." ] .

form:VideoObject a sh:NodeShape ;
    sh:targetClass schema:VideoObject ;
    rdfs:label "Video" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:embedUrl ; sh:order 2 ; sh:name "Player" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "The address of the player needed." ;
        sh:description "The address of the player of the video, such as https://video.edu.nl/videos/embed/<id>." ] ;
    sh:property [ sh:path schema:thumbnailUrl ; sh:order 3 ; sh:name "Thumbnail" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:duration ; sh:order 4 ; sh:name "Duration" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^P" ;
        sh:description "An ISO 8601 duration, such as PT5M38S." ] .

form:shows a rdf:Property ; rdfs:label "Shows" ;
    schema:domainIncludes schema:WebPageElement ; schema:rangeIncludes rdf:Property .
