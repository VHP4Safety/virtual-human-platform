@prefix schema: <https://schema.org/> .
@prefix bioschemas_draft: <https://bioschemas.org/draft_terms/> .
@prefix bioschemas: <https://bioschemas.org/terms/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix form: <https://platform.vhp4safety.nl/model/v1/form#> .
@prefix glossary: <https://vhp4safety.github.io/glossary#> .

form:casestudy a sh:PropertyGroup ; sh:order 1 ; rdfs:label "About the case study" .

form:workflow a sh:PropertyGroup ; sh:order 1 ; rdfs:label "Workflow page" .

form:parts a sh:PropertyGroup ; sh:order 2 ; rdfs:label "Parts" .

form:Study a sh:NodeShape ;
    form:path "casestudies" ; sh:order 3 ;
    sh:targetClass bioschemas_draft:Study ;
    dct:conformsTo <https://bioschemas.org/profiles/Study/0.3-DRAFT> ;
    rdfs:label "Case study" ;
    sh:property [ sh:path schema:creator ; sh:group form:casestudy ; sh:order 0 ; sh:name "Authors" ; form:shown false ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ;
        sh:description "The people and organisations who wrote the case study (Bioschemas' creator); kept in its data, not shown on its page." ] ;
    sh:property [ sh:path schema:name ; sh:group form:casestudy ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:description ; sh:group form:casestudy ; sh:order 2 ; sh:name "Aim" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "In one sentence." ] ;
    sh:property [ sh:path schema:about ; sh:group form:casestudy ; sh:order 3 ; sh:name "Condition" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a SNOMED CT or MONDO term, or register it." ;
        sh:description "The medical condition, as a SNOMED or MONDO term." ] ;
    sh:property [ sh:path schema:keywords ; sh:group form:casestudy ; sh:order 4 ; sh:name "Keywords" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it; text is kept until then." ;
        sh:description "What the case study deals with." ] ;
    sh:property [ sh:path schema:image ; sh:group form:casestudy ; sh:order 7 ; sh:name "Icon" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "Shown on the case studies page." ] ;
    sh:property [ sh:path schema:abstract ; sh:group form:casestudy ; sh:order 5 ; sh:name "Introduction to the questions" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:text ; sh:group form:casestudy ; sh:order 6 ; sh:name "Text" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "The page's text in HTML, when not in sections." ] ;
    sh:property [ sh:path schema:hasPart ; sh:group form:parts ; sh:order 1 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNode ;
        sh:description "Page sections, each with a heading, an HTML text and a position." ] ;
    sh:property [ sh:path glossary:VHP0000151 ; sh:group form:parts ; sh:order 2 ; sh:name "Regulatory questions" ;
        sh:class schema:HowTo ; sh:node form:HowTo ; sh:nodeKind sh:IRI ;
        sh:description "Each at /casestudies/<case>/<question>, with its workflow's steps." ] .

form:HowTo a sh:NodeShape ;
    sh:targetClass schema:HowTo ;
    rdfs:label "Workflow page" ;
    sh:property [ sh:path schema:name ; sh:group form:workflow ; sh:order 1 ; sh:name "Title" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One title needed." ;
        sh:description "Shown on its button, as the heading of its page, and in the way back to it." ] ;
    sh:property [ sh:path schema:text ; sh:group form:workflow ; sh:order 2 ; sh:name "Text" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "For a question: the question, shown on its button and on its page. For a step: text shown on its page, above its sections." ] ;
    sh:property [ sh:path schema:headline ; sh:group form:workflow ; sh:order 3 ; sh:name "Heading of its page" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "Only for a question: the heading of its page, in place of the title." ] ;
    sh:property [ sh:path schema:description ; sh:group form:workflow ; sh:order 4 ; sh:name "Summary" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "Shown under the heading of its page." ] ;
    sh:property [ sh:path schema:additionalType ; sh:group form:workflow ; sh:order 5 ; sh:name "Process flow step" ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:in ( glossary:VHP0000153 glossary:VHP0000154 glossary:VHP0000155 glossary:VHP0000156 glossary:VHP0000158 ) ;
        sh:message "Choose a process flow step from the list." ;
        sh:description "Only for the steps of a question, such as Exposure: the step of the process flow. Its button is named by it." ] ;
    sh:property [ sh:path schema:creativeWorkStatus ; sh:group form:workflow ; sh:order 6 ; sh:name "Status" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:in ( "disabled" ) ;
        sh:description "Empty: the page is shown and opened by its button. disabled: its button is shown greyed out, and the page cannot be opened yet." ] ;
    sh:property [ sh:path schema:position ; sh:group form:workflow ; sh:order 7 ; sh:name "Position" ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:description "Button order on the parent page; 1 is first." ] ;
    sh:property [ sh:path schema:hasPart ; sh:group form:parts ; sh:order 1 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNode ;
        sh:description "Page sections, each with a heading, an HTML text and a position." ] ;
    sh:property [ sh:path schema:step ; sh:group form:parts ; sh:order 2 ; sh:name "Steps" ;
        sh:class schema:HowTo ; sh:node form:HowTo ; sh:nodeKind sh:IRI ;
        sh:description "Each a page under this page's address; a question's are its process flow steps." ] ;
    sh:property [ sh:path schema:tool ; sh:group form:parts ; sh:order 3 ; sh:name "Tools and methods" ;
        sh:class schema:HowToTool ; sh:node form:HowToTool ; sh:nodeKind sh:BlankNode ;
        sh:description "Each tool, method or model that is used on the page. The names and descriptions are read from the records." ] ;
    sh:property [ sh:path schema:supply ; sh:group form:parts ; sh:order 4 ; sh:name "Data" ;
        sh:class schema:HowToSupply ; sh:node form:HowToSupply ; sh:nodeKind sh:BlankNode ;
        sh:description "Each use of a dataset on the page; names and descriptions come from their records." ] ;
    sh:property [ sh:path bioschemas:input ; sh:group form:parts ; sh:order 5 ; sh:name "Input" ;
        sh:or ( [ sh:class schema:Dataset ; rdfs:label "Data" ] [ sh:node form:FormalParameter ; rdfs:label "Name only" ] ) ;
        sh:description "What a step takes, such as an estimated daily intake. A dataset is linked, or a name is given when no record of it exists yet." ] ;
    sh:property [ sh:path bioschemas:output ; sh:group form:parts ; sh:order 6 ; sh:name "Output" ;
        sh:or ( [ sh:class schema:Dataset ; rdfs:label "Data" ] [ sh:node form:FormalParameter ; rdfs:label "Name only" ] ) ;
        sh:description "What a step gives, such as an exposure calculation. A dataset is linked, or a name is given when no record of it exists yet." ] .

form:HowToTool a sh:NodeShape ;
    sh:targetClass schema:HowToTool ;
    rdfs:label "Tool, method or model used" ;
    sh:property [ sh:path schema:item ; sh:order 1 ; sh:name "Tool, method or model" ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Warning ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class schema:SoftwareApplication ; rdfs:label "Tool" ] [ sh:class bioschemas_draft:LabProtocol ; rdfs:label "Method" ] [ sh:class schema:SoftwareSourceCode ; rdfs:label "Model" ] ) ;
        sh:message "Link a tool, method or model." ] .

form:HowToSupply a sh:NodeShape ;
    sh:targetClass schema:HowToSupply ;
    rdfs:label "Data used" ;
    sh:property [ sh:path schema:item ; sh:order 1 ; sh:name "Dataset" ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:class schema:Dataset ;
        sh:message "Link a dataset." ] .

form:WorkflowStep a sh:NodeShape ;
    sh:targetObjectsOf schema:step ;
    rdfs:label "Workflow step" ;
    sh:property [ sh:path bioschemas:input ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "Add the input." ] ;
    sh:property [ sh:path bioschemas:output ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "Add the output." ] .

form:FormalParameter a sh:NodeShape ;
    sh:targetClass bioschemas:FormalParameter ;
    dct:conformsTo <https://bioschemas.org/profiles/FormalParameter/1.0-RELEASE> ;
    rdfs:label "Input or output" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:description ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ; sh:datatype xsd:string ] .
