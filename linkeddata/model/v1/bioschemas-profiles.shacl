    sh:order 14 ;
    sh:path schema:isPartOf ;
    sh:severity sh:Warning .

<https://bioschemas.org/profiles/Dataset/1.0-RELEASE#keywords> a sh:PropertyShape ;
    sh:description "Keywords should be drawn from a controlled vocabulary, e.g. [EDAM](https://edamontology.org/), and supplied as a DefinedTerm list. Keywords or tags used to describe this content. Multiple entries in a keywords list are typically delimited by commas." ;
    sh:group <https://bioschemas.org/profiles/Dataset/1.0-RELEASE#group-required> ;
    sh:name "Keywords" ;
    sh:or ( <https://bioschemas.org/profiles/Dataset/1.0-RELEASE#definitions/definedterm> [ sh:nodeKind sh:Literal ] [ sh:nodeKind sh:IRI ] ) ;
