<https://bioschemas.org/profiles/Study/0.3-DRAFT#additionalProperty> a sh:PropertyShape ;
    sh:description "Used to provide arbirary properties of a study. A property-value pair representing an additional characteristics of the entitity, e.g. a product feature or another characteristic for which there is no matching property in schema.org. Note: Publishers should be aware that applications designed to use specific schema.org properties (e.g. http://schema.org/width, http://schema.org/color, http://schema.org/gtin13, ...) will typically expect such data to be provided using those properties, rather than using the generic property/value mechanism." ;
    sh:group <https://bioschemas.org/profiles/Study/0.3-DRAFT#group-recommended> ;
    sh:name "Additional property" ;
    sh:or ( <https://bioschemas.org/profiles/Study/0.3-DRAFT#definitions/propertyvalue> ) ;
    sh:order 2 ;
    sh:path schema:additionalProperty ;
    sh:severity sh:Warning .

<https://bioschemas.org/profiles/Study/0.3-DRAFT#additionalProperty-recommended> a sh:PropertyShape ;
    sh:minCount 1 ;
    sh:name "additionalProperty" ;
    sh:path schema:additionalProperty ;
    sh:severity sh:Warning .

<https://bioschemas.org/profiles/Study/0.3-DRAFT#author> a sh:PropertyShape ;
    sh:description "Used to indicate the person(s) or organizations that conducted the Study. Please use creator to indicate the Research project The author of this content or rating. Please note that author is special in that HTML 5 provides a special mechanism for indicating authorship via the rel tag. That is equivalent to this and may be used interchangeably." ;
    sh:group <https://bioschemas.org/profiles/Study/0.3-DRAFT#group-required> ;
    sh:maxCount 1 ;
    sh:name "Author" ;
    sh:or ( <https://bioschemas.org/profiles/Study/0.3-DRAFT#definitions/organization> <https://bioschemas.org/profiles/Study/0.3-DRAFT#definitions/person> ) ;
