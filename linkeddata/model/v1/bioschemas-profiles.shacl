<https://bioschemas.org/profiles/LabProtocol/0.8-DRAFT#reagent> a sh:PropertyShape ;
    sh:description "Reagents used in the protocol. DefinedTerm is preferred whenever possible, e.g., ChEBI and PubChem entities can be used whenever available. Commercial names are also acceptable. A reagent is defined as ‘A substance used in a chemical reaction to detect, measure, examine, or produce other substances’ in [CHEBI:33893](https://www.ebi.ac.uk/chebi/searchId.do?chebiId=CHEBI:33893)." ;
    sh:name "reagent" ;
    sh:or ( <https://bioschemas.org/profiles/LabProtocol/0.8-DRAFT#definitions/molecularentity> <https://bioschemas.org/profiles/LabProtocol/0.8-DRAFT#definitions/chemicalsubstance> <https://bioschemas.org/profiles/LabProtocol/0.8-DRAFT#definitions/biochementity> <https://bioschemas.org/profiles/LabProtocol/0.8-DRAFT#definitions/definedterm> [ sh:nodeKind sh:Literal ] [ sh:nodeKind sh:IRI ] ) ;
    sh:path ( bioschemas_draft:reagent [ sh:zeroOrMorePath rdf:rest ] rdf:first ) ;
    sh:severity sh:Warning .

<https://bioschemas.org/profiles/LabProtocol/0.8-DRAFT#reagent-required> a sh:PropertyShape ;
