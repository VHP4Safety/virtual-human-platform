<https://bioschemas.org/profiles/ScholarlyArticle/0.3-DRAFT#headline> a sh:PropertyShape ;
    sh:description "Title of the article (offer for compatibility, while schema.org uses name for this purpose, some scholarly material repostitories/archives use headline) Headline of the article." ;
    sh:group <https://bioschemas.org/profiles/ScholarlyArticle/0.3-DRAFT#group-optional> ;
