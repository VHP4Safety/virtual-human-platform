    sh:description "An organizer of an Event." ;
    sh:name "organizer" ;
    sh:or ( <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE#definitions/organization> <https://bioschemas.org/profiles/CourseInstance/1.0-RELEASE#definitions/person> ) ;
