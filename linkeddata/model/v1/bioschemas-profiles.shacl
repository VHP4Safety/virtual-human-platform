    sh:group <https://bioschemas.org/profiles/Dataset/1.0-RELEASE#group-optional> ;
    sh:maxCount 1 ;
    sh:name "Is accessible for free" ;
    sh:or ( [ sh:datatype xsd:boolean ] ) ;
    sh:order 12 ;
    sh:path schema:isAccessibleForFree ;
    sh:severity sh:Warning .

<https://bioschemas.org/profiles/Dataset/1.0-RELEASE#isBasedOn> a sh:PropertyShape ;
    sh:description "Use to link a Dataset to the Study that it was generated from. A resource that was used in the creation of this resource. This term can be repeated for multiple sources. For example, http://example.com/great-multiplication-intro.html. Supersedes isBasedOnUrl." ;
    sh:group <https://bioschemas.org/profiles/Dataset/1.0-RELEASE#group-recommended> ;
    sh:name "Is based on" ;
