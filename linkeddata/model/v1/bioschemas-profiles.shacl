    sh:name "identifier" ;
    sh:or ( <https://bioschemas.org/profiles/DataCatalog/0.3-RELEASE-2019_07_01#definitions/propertyValue> [ sh:nodeKind sh:Literal ] [ sh:nodeKind sh:IRI ] ) ;
    sh:path schema:identifier ;
