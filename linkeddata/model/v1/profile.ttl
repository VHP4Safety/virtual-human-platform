# The platform's application profile: what it adds to schema.org and Bioschemas.
#
# Each class has one node shape, named after it; its property shapes are the fields of its records.
# The editor's form, the pages and the linked data view are built from them alone; the vocabularies'
# value types only check values.
# - sh:group, sh:order, sh:name: a field's section, place and label. sh:description: its help.
# - sh:datatype: a text, a number or a date (xsd:date is picked in a calendar).
# - sh:nodeKind sh:IRI: a web address. sh:in: one of a list.
# - sh:class: a link to a record of a class; with sh:pattern, a term of one vocabulary only.
# - sh:or: a choice between classes. Records are found by name, or a new one is added.
# - sh:node: parts written with the record: without an address (sh:nodeKind sh:BlankNode), such as
#   page sections, or under the record's address (sh:nodeKind sh:IRI), such as case study questions.
# - sh:minCount: required; with sh:severity sh:Warning, recommended (shown, but a save is not stopped).
# - sh:hasValue: a fixed value. dash:singleLine false: a longer text.
# - sh:message: shown when a value is missing or does not fit.
# - form:private true: kept off the pages and their data; editors see it.
# - form:publishedAs: a class its values also have on the pages and their data, as schema.org expects (a
#   licence is a CreativeWork); the records keep their own.
# The required fields of tools are the minimum of the Bioschemas ComputationalTool profile.

@prefix schema: <https://schema.org/> .
@prefix bioschemas_draft: <https://bioschemas.org/draft_terms/> .
@prefix bioschemas: <https://bioschemas.org/terms/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix form: <https://platform.vhp4safety.nl/model/v1/form#> .
@prefix glossary: <https://vhp4safety.github.io/glossary#> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix pbpk: <https://platform.vhp4safety.nl/model/v1/pbpk#> .

form:about a sh:PropertyGroup ; sh:order 1 ; rdfs:label "About the tool" .
form:method a sh:PropertyGroup ; sh:order 1 ; rdfs:label "About the method" .
form:assay a sh:PropertyGroup ; sh:order 2 ; rdfs:label "Assay" .
form:people a sh:PropertyGroup ; sh:order 2 ; rdfs:label "People" .
form:documentation a sh:PropertyGroup ; sh:order 3 ; rdfs:label "Documentation and training" .
form:technical a sh:PropertyGroup ; sh:order 4 ; rdfs:label "Technical details" .
form:elsewhere a sh:PropertyGroup ; sh:order 5 ; rdfs:label "Elsewhere on the web" .
form:casestudy a sh:PropertyGroup ; sh:order 1 ; rdfs:label "About the case study" .
form:workflow a sh:PropertyGroup ; sh:order 1 ; rdfs:label "Workflow page" .
form:parts a sh:PropertyGroup ; sh:order 2 ; rdfs:label "Parts" .

# A text is plain, or HTML (rdf:HTML) when it has markup such as <p> or <b>.
form:PlainText a sh:NodeShape ; rdfs:label "Text" ; sh:datatype xsd:string ; sh:not [ sh:pattern "<\\s*/?[a-zA-Z][^>]*>" ] .
form:HTMLText a sh:NodeShape ; rdfs:label "HTML" ; sh:datatype rdf:HTML .

form:SoftwareApplication a sh:NodeShape ;
    sh:targetClass schema:SoftwareApplication ;
    rdfs:label "Tool" ;
    rdfs:comment "Tools state their Bioschemas profile (ComputationalTool)." ;
    sh:property [
        sh:path schema:name ; sh:group form:about ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "As its developers write it." ;
        sh:message "One name needed." ] ;
    sh:property [
        sh:path schema:description ; sh:group form:about ; sh:order 2 ; sh:name "Description" ; sh:minCount 1 ; sh:maxCount 1 ;
        dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "What the tool does, in two or three sentences. Shown in the catalogue and on the tool's page." ;
        sh:message "One description needed." ] ;
    sh:property [
        sh:path schema:url ; sh:group form:about ; sh:order 3 ; sh:name "Website" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:description "Website or documentation." ;
        sh:message "Add the website, if any." ] ;
    sh:property [
        sh:path schema:installUrl ; sh:group form:about ; sh:order 4 ; sh:name "Where to use it" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "Where the tool runs, if not its website. Linked as \"Run the tool\"." ] ;
    sh:property [
        sh:path schema:image ; sh:group form:about ; sh:order 5 ; sh:name "Logo or screenshot" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "Shown on the tool's card in the catalogue." ] ;
    sh:property [
        sh:path glossary:VHP0000152 ; sh:group form:about ; sh:order 6 ; sh:name "Assessment steps" ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:in ( glossary:VHP0000153 glossary:VHP0000154 glossary:VHP0000155 glossary:VHP0000156 glossary:VHP0000158 ) ;
        sh:message "Choose from the list; other values are not in the filters." ;
        sh:description "Process flow steps the tool supports; the catalogue is filtered by them." ] ;
    sh:property [
        sh:path glossary:VHP0000151 ; sh:group form:about ; sh:order 7 ; sh:name "Case-study questions" ;
        sh:class schema:HowTo ;
        sh:description "Case study questions the tool helps answer; the catalogue is filtered by them." ] ;
    sh:property [
        sh:path schema:about ; sh:group form:about ; sh:order 8 ; sh:name "Topics" ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it." ;
        sh:description "What the tool deals with, such as Model or Adverse Outcome Pathway." ] ;
    sh:property [
        sh:path schema:provider ; sh:group form:people ; sh:order 1 ; sh:name "Provided by" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ;
        sh:description "Who offers the tool. VHP4Safety, when it runs on the platform's servers, is shown as its host." ] ;
    sh:property [
        sh:path schema:creator ; sh:group form:people ; sh:order 2 ; sh:name "Developed by" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ;
        sh:description "Who developed the tool; VHP4Safety when the project did." ] ;
    sh:property [
        sh:path schema:maintainer ; sh:group form:people ; sh:order 3 ; sh:name "Contact people" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ;
        sh:description "Who to contact. Names and email addresses are shown on the support tab." ] ;
    sh:property [
        sh:path schema:softwareHelp ; sh:group form:documentation ; sh:order 1 ; sh:name "Guides and demos" ;
        sh:class schema:WebPage ; sh:node form:WebPage ; sh:nodeKind sh:BlankNode ;
        sh:description "Introductions, tutorials, demos and deployment guides, each with a title." ] ;
    sh:property [
        sh:path schema:subjectOf ; sh:group form:documentation ; sh:order 2 ; sh:name "Used in workflows" ;
        sh:class schema:WebPage ; sh:node form:WebPage ; sh:nodeKind sh:BlankNode ;
        sh:description "VHP4Safety workflows and tutorials that use the tool, each with a title." ] ;
    sh:property [
        sh:path schema:video ; sh:group form:documentation ; sh:order 3 ; sh:name "Videos" ;
        sh:class schema:VideoObject ; sh:node form:VideoObject ; sh:nodeKind sh:BlankNode ;
        sh:description "Videos shown on its page, such as PeerTube ones, each with a title." ] ;
    sh:property [
        sh:path schema:citation ; sh:group form:documentation ; sh:order 4 ; sh:name "Publication to cite" ; sh:maxCount 1 ;
        sh:class schema:ScholarlyArticle ;
        sh:description "The publication to cite when the tool is used; its page links to its DOI." ] ;
    sh:property [
        sh:path schema:keywords ; sh:group form:documentation ; sh:order 5 ; sh:name "Training search term" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "Searched on ELIXIR TeSS and Taxila; the results are shown on the tool's page." ] ;
    sh:property [
        sh:path schema:softwareVersion ; sh:group form:technical ; sh:order 1 ; sh:name "Version" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "As its developers number it." ] ;
    sh:property [
        sh:path schema:license ; sh:group form:technical ; sh:order 2 ; sh:name "License" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ; sh:pattern "^https://spdx\\.org/licenses/" ; form:publishedAs schema:CreativeWork ;
        sh:message "Add the license, chosen from SPDX; other values are kept." ;
        sh:description "The tool's license." ] ;
    sh:property [
        sh:path schema:isBasedOn ; sh:group form:technical ; sh:order 3 ; sh:name "Source code" ; sh:nodeKind sh:IRI ;
        sh:description "Its repository, such as on GitHub." ] ;
    sh:property [
        sh:path schema:downloadUrl ; sh:group form:technical ; sh:order 4 ; sh:name "Downloads" ; sh:nodeKind sh:IRI ;
        sh:description "Container images or software packages." ] ;
    sh:property [
        sh:path schema:creativeWorkStatus ; sh:group form:technical ; sh:order 5 ; sh:name "Technology readiness" ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ;
        sh:in ( wd:Q120669280 wd:Q120669304 wd:Q120669316 wd:Q120669327 wd:Q120669340 wd:Q120669350 wd:Q120669358 wd:Q120669370 wd:Q120669377 ) ;
        sh:description "From TRL 1 (basic principles observed) to TRL 9 (proven in its operational environment)." ;
        sh:message "Choose a level from TRL 1 to TRL 9; text is kept." ] ;
    sh:property [
        sh:path schema:releaseNotes ; sh:group form:technical ; sh:order 6 ; sh:name "Release notes" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "Address of the release notes, or a short note on the latest release." ] ;
    sh:property [
        sh:path schema:sameAs ; sh:group form:elsewhere ; sh:order 1 ; sh:name "Other addresses" ; sh:nodeKind sh:IRI ;
        sh:description "Such as bio.tools, FAIRsharing, Wikipedia or the Research Software Directory. Earlier platform addresses are kept here, so old links still work." ] ;
    sh:property [
        sh:path dct:conformsTo ; sh:group form:elsewhere ; sh:order 2 ; sh:name "Bioschemas profile" ; sh:nodeKind sh:IRI ;
        sh:hasValue <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
        sh:description "Bioschemas ComputationalTool 1.0, read by search engines and registries." ;
        sh:message "ComputationalTool 1.0-RELEASE expected." ] .

form:Organization a sh:NodeShape ;
    sh:targetClass schema:Organization ;
    rdfs:label "Organisation" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:url ; sh:order 2 ; sh:name "Website" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 3 ; sh:name "Elsewhere" ; sh:nodeKind sh:IRI ;
        sh:description "Its Wikidata or ROR item, and other addresses." ] ;
    sh:property [ sh:path schema:alternateName ; sh:order 4 ; sh:name "Other names" ; sh:datatype xsd:string ;
        sh:description "Such as its full name, or its abbreviation." ] ;
    sh:property [ sh:path schema:description ; sh:order 5 ; sh:name "Description" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:logo ; sh:order 6 ; sh:name "Logo" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "Shown among the platform's partners." ] ;
    sh:property [ sh:path schema:email ; sh:order 7 ; sh:name "Contact email" ; sh:maxCount 1 ; sh:datatype xsd:string ; form:private true ;
        sh:description "A general address of the organisation." ] .

# A research project, such as VHP4Safety: an organisation with its grants, videos, figures, research lines,
# partners and co-funders.
form:ResearchProject a sh:NodeShape ;
    sh:targetClass schema:ResearchProject ;
    sh:node form:Organization ;
    rdfs:label "Project" ;
    sh:property [ sh:path schema:funding ; sh:order 7 ; sh:name "Grants" ; sh:class schema:MonetaryGrant ;
        sh:description "Publications and data that name one of its grants are its outputs." ] ;
    sh:property [ sh:path schema:subjectOf ; sh:order 8 ; sh:name "Videos" ; sh:class schema:VideoObject ; sh:node form:VideoObject ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path schema:image ; sh:order 9 ; sh:name "Figures" ; sh:class schema:ImageObject ; sh:node form:ImageObject ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path schema:subOrganization ; sh:order 10 ; sh:name "Research lines" ; sh:class schema:ResearchProject ; sh:node form:ResearchProject ; sh:nodeKind sh:BlankNode ;
        sh:description "Each with its name and what it does." ] ;
    sh:property [ sh:path schema:member ; sh:order 11 ; sh:name "Partners" ; sh:class schema:OrganizationRole ; sh:node form:OrganizationRole ; sh:nodeKind sh:BlankNode ;
        sh:description "Each partner organisation with its role, such as coordination." ] ;
    sh:property [ sh:path schema:funder ; sh:order 12 ; sh:name "Co-funders" ; sh:class schema:Organization ] .

# A partner of a project, with its role; it is part of the project's record.
form:OrganizationRole a sh:NodeShape ;
    sh:targetClass schema:OrganizationRole ;
    rdfs:label "Partner" ;
    sh:property [ sh:path schema:member ; sh:order 1 ; sh:name "Organisation" ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:Organization ; sh:message "One organisation needed." ] ;
    sh:property [ sh:path schema:roleName ; sh:order 2 ; sh:name "Role" ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# A grant, at /grants/<name>, with its funder, number and amount; the records that name it (schema:funding)
# are what it funds.
form:MonetaryGrant a sh:NodeShape ;
    sh:targetClass schema:MonetaryGrant ;
    rdfs:label "Grant" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:identifier ; sh:order 2 ; sh:name "Grant number" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:funder ; sh:order 3 ; sh:name "Funder" ; sh:minCount 1 ; sh:severity sh:Warning ; sh:class schema:Organization ;
        sh:message "Add the funder." ] ;
    sh:property [ sh:path schema:amount ; sh:order 4 ; sh:name "Amount" ; sh:maxCount 1 ; sh:class schema:MonetaryAmount ; sh:node form:MonetaryAmount ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path schema:url ; sh:order 5 ; sh:name "Page" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "The funder's page of the grant." ] ;
    sh:property [ sh:path schema:description ; sh:order 6 ; sh:name "Description" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] .

# An amount of money; it is part of its grant's record.
form:MonetaryAmount a sh:NodeShape ;
    sh:targetClass schema:MonetaryAmount ;
    rdfs:label "Amount" ;
    sh:property [ sh:path schema:value ; sh:order 1 ; sh:name "Value" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:message "One number needed." ] ;
    sh:property [ sh:path schema:currency ; sh:order 2 ; sh:name "Currency" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[A-Z]{3}$" ;
        sh:message "A three-letter currency code, such as EUR." ] .

# The platform, at its own address: a catalogue of the records, with its publisher, licence and kinds of
# records. Its VoID description (/.well-known/void, and the platform's address in Turtle) is made from it.
form:DataCatalog a sh:NodeShape ;
    sh:targetClass schema:DataCatalog ;
    rdfs:label "Platform" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:alternateName ; sh:order 2 ; sh:name "Heading" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "The name as the home page heads it." ] ;
    sh:property [ sh:path schema:abstract ; sh:order 3 ; sh:name "In one sentence" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:order 4 ; sh:name "Description" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:publisher ; sh:order 5 ; sh:name "Publisher" ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Warning ; sh:class schema:Organization ;
        sh:message "Add who publishes the platform." ;
        sh:description "Its partners are the platform's contributors." ] ;
    sh:property [ sh:path schema:license ; sh:order 6 ; sh:name "Licence of the records" ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Warning ;
        sh:class schema:DefinedTerm ; sh:pattern "^https://spdx\\.org/licenses/" ; form:publishedAs schema:CreativeWork ;
        sh:message "Choose the licence of the platform's records; none is stated until then." ] ;
    sh:property [ sh:path schema:subjectOf ; sh:order 7 ; sh:name "Pages about it" ; sh:class schema:WebPage ] ;
    sh:property [ sh:path void:classPartition ; sh:order 8 ; sh:name "Kinds of records" ; sh:node form:ClassPartition ; sh:nodeKind sh:BlankNode ;
        sh:description "Each kind's name and description, as the home page shows them; their counts are added." ] .

# A kind of records of the platform: its class, name and description; it is part of the platform's record.
form:ClassPartition a sh:NodeShape ;
    rdfs:label "Kind of records" ;
    sh:property [ sh:path void:class ; sh:order 1 ; sh:name "Class" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "One class needed." ] ;
    sh:property [ sh:path schema:name ; sh:order 2 ; sh:name "Name" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:order 3 ; sh:name "Description" ; sh:maxCount 1 ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:position ; sh:order 4 ; sh:name "Position" ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:description "Its place among the kinds on the home page; 1 is first." ] .

form:Person a sh:NodeShape ;
    sh:targetClass schema:Person ;
    rdfs:label "Person" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:email ; sh:order 2 ; sh:name "Email address" ; sh:maxCount 1 ; sh:datatype xsd:string ; form:private true ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 3 ; sh:name "Elsewhere" ; sh:nodeKind sh:IRI ;
        sh:description "ORCID iD or Wikidata item, as a web address." ] ;
    sh:property [ sh:path schema:affiliation ; sh:order 4 ; sh:name "Affiliation" ; sh:class schema:Organization ] .

form:LabProtocol a sh:NodeShape ;
    sh:targetClass bioschemas_draft:LabProtocol ;
    rdfs:label "Method" ;
    rdfs:comment "Methods state their Bioschemas profile (LabProtocol)." ;
    sh:property [
        sh:path schema:name ; sh:group form:method ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "As known in the lab." ;
        sh:message "One name needed." ] ;
    sh:property [
        sh:path schema:description ; sh:group form:method ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ;
        dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "What the method measures or shows, in one or two sentences." ] ;
    sh:property [
        sh:path glossary:VHP0000152 ; sh:group form:method ; sh:order 3 ; sh:name "Assessment steps" ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:in ( glossary:VHP0000153 glossary:VHP0000154 glossary:VHP0000155 glossary:VHP0000156 glossary:VHP0000158 ) ;
        sh:message "Choose from the list; other values are not in the filters." ;
        sh:description "Process flow steps the method informs." ] ;
    sh:property [
        sh:path glossary:VHP0000151 ; sh:group form:method ; sh:order 4 ; sh:name "Case-study questions" ;
        sh:class schema:HowTo ;
        sh:description "Case study questions the method informs." ] ;
    sh:property [
        sh:path schema:about ; sh:group form:method ; sh:order 5 ; sh:name "Key events, pathways and topics" ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a term, such as an AOP-Wiki key event, or register it." ;
        sh:description "AOP-Wiki key events and pathways the method measures, and glossary terms." ] ;
    sh:property [
        sh:path schema:additionalType ; sh:group form:method ; sh:order 6 ; sh:name "Kind of assay" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a term, such as from BAO or OBI, or register it." ;
        sh:description "The kind of assay, as OBI or BAO terms." ] ;
    sh:property [
        sh:path schema:alternateName ; sh:group form:assay ; sh:order 1 ; sh:name "Assay name" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "The assay or kit name, as its vendor gives it." ] ;
    sh:property [
        sh:path schema:provider ; sh:group form:assay ; sh:order 2 ; sh:name "Vendor" ;
        sh:class schema:Organization ;
        sh:description "The company that sells the assay or kit." ] ;
    sh:property [
        sh:path schema:identifier ; sh:group form:assay ; sh:order 3 ; sh:name "Catalogue number" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "The vendor's catalogue number." ] ;
    sh:property [
        sh:path schema:url ; sh:group form:assay ; sh:order 4 ; sh:name "Product page" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "The vendor's page." ] ;
    sh:property [
        sh:path schema:creator ; sh:group form:people ; sh:order 1 ; sh:name "Data producer" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ;
        sh:description "Who produces data with the method in VHP4Safety." ] ;
    sh:property [
        sh:path schema:citation ; sh:group form:documentation ; sh:order 1 ; sh:name "Publications" ;
        sh:class schema:ScholarlyArticle ;
        sh:description "Publications on the method; their pages link to their DOIs." ] ;
    sh:property [
        sh:path schema:subjectOf ; sh:group form:documentation ; sh:order 2 ; sh:name "Standard operating procedure" ; sh:nodeKind sh:IRI ;
        sh:description "The protocol the lab follows." ] ;
    sh:property [
        sh:path schema:isBasedOn ; sh:group form:elsewhere ; sh:order 1 ; sh:name "Catalogue request" ; sh:nodeKind sh:IRI ;
        sh:description "The cloud catalogue request the record was made from." ] ;
    sh:property [
        sh:path dct:conformsTo ; sh:group form:elsewhere ; sh:order 2 ; sh:name "Bioschemas profile" ; sh:nodeKind sh:IRI ;
        sh:hasValue <https://bioschemas.org/profiles/LabProtocol/0.9-DRAFT> ;
        sh:message "LabProtocol 0.9-DRAFT expected." ] .

# A case study, at /casestudies/<case>, with its regulatory questions (Bioschemas Study, a CreativeWork).
form:Study a sh:NodeShape ;
    sh:targetClass bioschemas_draft:Study ;
    rdfs:label "Case study" ;
    sh:property [ sh:path schema:name ; sh:group form:casestudy ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:description ; sh:group form:casestudy ; sh:order 2 ; sh:name "Aim" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "In one sentence." ] ;
    sh:property [ sh:path schema:about ; sh:group form:casestudy ; sh:order 3 ; sh:name "Condition" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a SNOMED CT or MONDO term, or register it." ;
        sh:description "The medical condition, as a SNOMED or MONDO term." ] ;
    sh:property [ sh:path schema:keywords ; sh:group form:casestudy ; sh:order 4 ; sh:name "Keywords" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it; text is kept until then." ;
        sh:description "What the case study deals with." ] ;
    sh:property [ sh:path schema:image ; sh:group form:casestudy ; sh:order 7 ; sh:name "Icon" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "Shown on the case studies page." ] ;
    sh:property [ sh:path schema:abstract ; sh:group form:casestudy ; sh:order 5 ; sh:name "Introduction to the questions" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:text ; sh:group form:casestudy ; sh:order 6 ; sh:name "Text" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "The page's text in HTML, when not in sections." ] ;
    sh:property [ sh:path schema:hasPart ; sh:group form:parts ; sh:order 1 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNode ;
        sh:description "Page sections, each with a heading, an HTML text and a position." ] ;
    sh:property [ sh:path glossary:VHP0000151 ; sh:group form:parts ; sh:order 2 ; sh:name "Regulatory questions" ;
        sh:class schema:HowTo ; sh:node form:HowTo ; sh:nodeKind sh:IRI ;
        sh:description "Each at /casestudies/<case>/<question>, with its workflow's steps." ] .

# A page of a case study's workflow: a regulatory question, at /casestudies/<case>/<question>, or a process flow
# step or part of one, at an address under its parent page; with its steps, tools, data and text. It is part
# of its case study's record.
form:HowTo a sh:NodeShape ;
    sh:targetClass schema:HowTo ;
    rdfs:label "Workflow page" ;
    sh:property [ sh:path schema:name ; sh:group form:workflow ; sh:order 1 ; sh:name "Title" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One title needed." ] ;
    sh:property [ sh:path schema:text ; sh:group form:workflow ; sh:order 2 ; sh:name "Text" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "A question's wording; on other pages, the page's text in HTML, when not in sections." ] ;
    sh:property [ sh:path schema:headline ; sh:group form:workflow ; sh:order 3 ; sh:name "Heading of its page" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:group form:workflow ; sh:order 4 ; sh:name "Summary" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:additionalType ; sh:group form:workflow ; sh:order 5 ; sh:name "Process flow step" ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:in ( glossary:VHP0000153 glossary:VHP0000154 glossary:VHP0000155 glossary:VHP0000156 glossary:VHP0000158 ) ;
        sh:message "Choose a process flow step from the list." ;
        sh:description "The kind of process flow step the page is, for a question's steps; their buttons are named by it." ] ;
    sh:property [ sh:path schema:creativeWorkStatus ; sh:group form:workflow ; sh:order 6 ; sh:name "Status" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "\"disabled\": the button is shown but cannot be opened yet." ] ;
    sh:property [ sh:path schema:position ; sh:group form:workflow ; sh:order 7 ; sh:name "Position" ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:description "Button order on the parent page; 1 is first." ] ;
    sh:property [ sh:path schema:hasPart ; sh:group form:parts ; sh:order 1 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNode ;
        sh:description "Page sections, each with a heading, an HTML text and a position." ] ;
    sh:property [ sh:path schema:step ; sh:group form:parts ; sh:order 2 ; sh:name "Steps" ;
        sh:class schema:HowTo ; sh:node form:HowTo ; sh:nodeKind sh:IRI ;
        sh:description "Each a page under this page's address; a question's are its process flow steps." ] ;
    sh:property [ sh:path schema:tool ; sh:group form:parts ; sh:order 3 ; sh:name "Tools and methods" ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class schema:SoftwareApplication ; rdfs:label "Tool" ] [ sh:class bioschemas_draft:LabProtocol ; rdfs:label "Method" ] ) ;
        form:publishedAs schema:HowToTool ;
        sh:message "Link a tool or method." ;
        sh:description "Tools and methods the page uses; names and descriptions come from their records." ] ;
    sh:property [ sh:path schema:supply ; sh:group form:parts ; sh:order 4 ; sh:name "Data" ; sh:nodeKind sh:IRI ; sh:class schema:Dataset ;
        form:publishedAs schema:HowToSupply ;
        sh:message "Link a dataset." ;
        sh:description "Datasets the page uses; names and descriptions come from their records." ] ;
    sh:property [ sh:path bioschemas:input ; sh:group form:parts ; sh:order 5 ; sh:name "Input" ;
        sh:class bioschemas:FormalParameter ; sh:node form:FormalParameter ; sh:nodeKind sh:BlankNode ;
        sh:description "What a step takes, such as an estimated daily intake." ] ;
    sh:property [ sh:path bioschemas:output ; sh:group form:parts ; sh:order 6 ; sh:name "Output" ;
        sh:class bioschemas:FormalParameter ; sh:node form:FormalParameter ; sh:nodeKind sh:BlankNode ;
        sh:description "What a step gives, such as an exposure calculation." ] .

# A workflow step (the value of a schema:step) is expected to state its input and output.
form:WorkflowStep a sh:NodeShape ;
    sh:targetObjectsOf schema:step ;
    rdfs:label "Workflow step" ;
    sh:property [ sh:path bioschemas:input ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "Add the input." ] ;
    sh:property [ sh:path bioschemas:output ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "Add the output." ] .

# An input or output of a workflow step, by name. It is part of its step's record.
form:FormalParameter a sh:NodeShape ;
    sh:targetClass bioschemas:FormalParameter ;
    rdfs:label "Input or output" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:description ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# A page section: heading, HTML text and position. It is part of its page's record.
form:WebPageElement a sh:NodeShape ;
    sh:targetClass schema:WebPageElement ;
    rdfs:label "Section" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Heading" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:text ; sh:order 2 ; sh:name "Text" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:position ; sh:order 3 ; sh:name "Position" ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path schema:image ; sh:order 4 ; sh:name "Figures" ; sh:class schema:ImageObject ; sh:node form:ImageObject ; sh:nodeKind sh:BlankNode ;
        sh:description "Shown after the text." ] ;
    sh:property [ sh:path schema:video ; sh:order 5 ; sh:name "Videos" ; sh:class schema:VideoObject ; sh:node form:VideoObject ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path schema:creativeWorkStatus ; sh:order 6 ; sh:name "Status" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "\"hidden\": kept, but not shown." ] ;
    sh:property [ sh:path schema:hasPart ; sh:order 7 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNode ;
        sh:description "Its own sections, shown as its items." ] ;
    sh:property [ sh:path schema:about ; sh:order 8 ; sh:name "Lists the outputs of" ; sh:maxCount 1 ; sh:class schema:MonetaryGrant ;
        sh:description "A grant: the section lists the records that name it, such as its publications." ] .

# A figure: an image's address and caption; it is part of the record that shows it.
form:ImageObject a sh:NodeShape ;
    sh:targetClass schema:ImageObject ;
    rdfs:label "Figure" ;
    sh:property [ sh:path schema:contentUrl ; sh:order 1 ; sh:name "Image" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:message "One image address needed." ] ;
    sh:property [ sh:path schema:caption ; sh:order 2 ; sh:name "Caption" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "Also read out in place of the image." ] .

# A publication's journal, with its ISSNs; it is part of the publication's record.
form:Periodical a sh:NodeShape ;
    sh:targetClass schema:Periodical ;
    rdfs:label "Journal" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:issn ; sh:order 2 ; sh:name "ISSN" ; sh:datatype xsd:string ; sh:pattern "^[0-9]{4}-[0-9]{3}[0-9X]$" ] .

# A publication, at /publications/<DOI>, with the DOI's address in sameAs.
form:ScholarlyArticle a sh:NodeShape ;
    sh:targetClass schema:ScholarlyArticle ;
    rdfs:label "Publication" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:maxCount 1 ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:author ; sh:order 2 ; sh:name "Authors" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ] ;
    sh:property [ sh:path schema:datePublished ; sh:order 3 ; sh:name "Published" ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:date ; rdfs:label "Date" ] [ sh:datatype xsd:gYearMonth ; rdfs:label "Month" ] [ sh:datatype xsd:gYear ; rdfs:label "Year" ] ) ;
        sh:description "A date, a month or a year, as precise as the publisher gives it." ] ;
    sh:property [ sh:path schema:isPartOf ; sh:order 4 ; sh:name "Journal" ; sh:maxCount 1 ;
        sh:class schema:Periodical ; sh:node form:Periodical ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 5 ; sh:name "DOI and other addresses" ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "DOI needed, starting with https://doi.org/10." ;
        sh:description "The DOI as a web address, the Wikidata item, and other addresses." ] ;
    sh:property [ sh:path schema:funding ; sh:order 6 ; sh:name "Funded by" ; sh:class schema:MonetaryGrant ;
        sh:description "The grants it acknowledges; a project's page lists the publications of its grants." ] .

# A page of the platform, with its text in sections; or a page elsewhere, such as a tool's guide, as part
# of the tool's record.
form:WebPage a sh:NodeShape ;
    sh:targetClass schema:WebPage ;
    rdfs:label "Page" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:url ; sh:order 3 ; sh:name "Address elsewhere" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:about ; sh:order 4 ; sh:name "Terms explained" ; sh:class schema:DefinedTerm ;
        sh:description "A term whose kinds the page explains, such as Process Flow Step." ] ;
    sh:property [ sh:path schema:hasPart ; sh:order 5 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNode ;
        sh:description "Sections of a platform page, each with a heading, a text and a position; a section's own sections are its items." ] .

# A page about a project or organisation, whose record gives what it is; the page's sections give the rest.
form:AboutPage a sh:NodeShape ;
    sh:targetClass schema:AboutPage ;
    sh:node form:WebPage ;
    rdfs:label "About page" ;
    sh:property [ sh:path schema:mainEntity ; sh:order 6 ; sh:name "About" ; sh:maxCount 1 ; sh:class schema:Organization ;
        sh:description "Its description, videos, figures, research lines, grants and partners are shown, and the publications of its grants." ] .

# A video, such as a PeerTube one, shown in its player; it is part of the record that shows it.
form:VideoObject a sh:NodeShape ;
    sh:targetClass schema:VideoObject ;
    rdfs:label "Video" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:embedUrl ; sh:order 2 ; sh:name "Player" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "The player's address needed." ;
        sh:description "The address of the video's player, such as https://video.edu.nl/videos/embed/<id>." ] .

# A dataset, at /data/<identifier>, based on a BioStudies study or a Zenodo record (schema:isBasedOn).
form:Dataset a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    rdfs:label "Dataset" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One title needed." ] ;
    sh:property [ sh:path schema:description ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:creator ; sh:order 3 ; sh:name "Authors" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ] ;
    sh:property [ sh:path schema:datePublished ; sh:order 4 ; sh:name "Published" ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path glossary:VHP0000152 ; sh:order 5 ; sh:name "Assessment steps" ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:in ( glossary:VHP0000153 glossary:VHP0000154 glossary:VHP0000155 glossary:VHP0000156 glossary:VHP0000158 ) ;
        sh:message "Choose from the list; other values are not in the filters." ] ;
    sh:property [ sh:path glossary:VHP0000151 ; sh:order 6 ; sh:name "Case-study questions" ; sh:class schema:HowTo ] ;
    sh:property [ sh:path schema:isPartOf ; sh:order 6 ; sh:name "Case studies" ; sh:class bioschemas_draft:Study ;
        sh:description "Case studies the data was made for." ] ;
    sh:property [ sh:path schema:about ; sh:order 7 ; sh:name "Topics" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it." ;
        sh:description "What the data is about, such as the organism." ] ;
    sh:property [ sh:path schema:measurementMethod ; sh:order 8 ; sh:name "Methods" ; sh:class bioschemas_draft:LabProtocol ;
        sh:description "Methods the data was measured with." ] ;
    sh:property [ sh:path schema:measurementTechnique ; sh:order 9 ; sh:name "Assays" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a term, such as from BAO, or register it." ;
        sh:description "Assays the data was measured with, as terms of BAO or other ontologies." ] ;
    sh:property [ sh:path schema:citation ; sh:order 10 ; sh:name "Publications" ; sh:class schema:ScholarlyArticle ] ;
    sh:property [ sh:path schema:license ; sh:order 11 ; sh:name "License" ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Warning ;
        sh:class schema:DefinedTerm ; sh:pattern "^https://spdx\\.org/licenses/" ; form:publishedAs schema:CreativeWork ;
        sh:message "Add the license, chosen from SPDX; other values are kept." ] ;
    sh:property [ sh:path schema:isBasedOn ; sh:order 12 ; sh:name "Source record" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "The BioStudies or Zenodo record this one is made from, every night." ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 13 ; sh:name "DOI and other addresses" ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:keywords ; sh:order 14 ; sh:name "Keywords" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it; text is kept until then." ] .

# A vocabulary or ontology term, at its own address, with its label and vocabulary, so that records can
# be about it.
form:DefinedTerm a sh:NodeShape ;
    sh:targetClass schema:DefinedTerm ;
    rdfs:label "Term" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Label" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One label needed." ] ;
    sh:property [ sh:path schema:inDefinedTermSet ; sh:order 2 ; sh:name "Vocabulary" ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:DefinedTermSet ;
        sh:message "One vocabulary needed." ] ;
    sh:property [ sh:path schema:termCode ; sh:order 3 ; sh:name "Code" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:alternateName ; sh:order 5 ; sh:name "Other names" ; sh:datatype xsd:string ;
        sh:description "Such as a short name." ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 6 ; sh:name "Other addresses" ;
        sh:or ( [ sh:class schema:DefinedTerm ; rdfs:label "Term" ] [ sh:nodeKind sh:IRI ; rdfs:label "Address" ] ) ;
        sh:description "The same term in another vocabulary, or another address, such as a license's text." ] ;
    sh:property [ sh:path schema:description ; sh:order 4 ; sh:name "Definition" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] .

# A vocabulary or ontology, at /vocabularies/<name>; its terms name it (inDefinedTermSet), and their
# addresses may share a namespace.
form:DefinedTermSet a sh:NodeShape ;
    sh:targetClass schema:DefinedTermSet ;
    rdfs:label "Vocabulary" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path void:uriSpace ; sh:order 2 ; sh:name "Namespace" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^https?://" ;
        sh:message "One web address start, such as http://purl.obolibrary.org/obo/NCBITaxon_." ;
        sh:description "The start of its terms' addresses, when they share one." ] ;
    sh:property [ sh:path schema:url ; sh:order 3 ; sh:name "Home page" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 4 ; sh:name "Same as" ; sh:nodeKind sh:IRI ;
        sh:description "Its own address elsewhere, such as its Wikidata item." ] ;
    sh:property [ sh:path schema:description ; sh:order 5 ; sh:name "Description" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:license ; sh:order 6 ; sh:name "License" ; sh:minCount 1 ; sh:maxCount 1 ; sh:severity sh:Warning ; sh:nodeKind sh:IRI ;
        sh:message "Add the license of its terms: an SPDX license, or the address of its terms of use." ;
        sh:description "The terms that records link to are published with it, under this license." ] .

# The sections of ROBOT's PBPK form (Research Object Builder for Open Toxicology, after Tan et al. 2020).
form:modelGeneral a sh:PropertyGroup ; sh:order 1 ; rdfs:label "General Model Information" .
form:modelModelStructure a sh:PropertyGroup ; sh:order 2 ; rdfs:label "Model Structure and Mathematical Representation" .
form:modelChemicals a sh:PropertyGroup ; sh:order 3 ; rdfs:label "Chemical(s) Description" .
form:modelBiologicalSystem a sh:PropertyGroup ; sh:order 4 ; rdfs:label "Biological System Description" .
form:modelParameterization a sh:PropertyGroup ; sh:order 5 ; rdfs:label "Parameterisation" .
form:modelCalibration a sh:PropertyGroup ; sh:order 6 ; rdfs:label "Calibration and Parameter Estimation" .
form:modelValidation a sh:PropertyGroup ; sh:order 7 ; rdfs:label "Model Evaluation and Validation" .
form:modelUncertainty a sh:PropertyGroup ; sh:order 8 ; rdfs:label "Sensitivity, Uncertainty, and Variability Analyses" .
form:modelApplicability a sh:PropertyGroup ; sh:order 9 ; rdfs:label "Model Applicability and Limitations" .
form:modelElectronicFiles a sh:PropertyGroup ; sh:order 10 ; rdfs:label "Electronic Files and Reproducibility" .
form:modelLinks a sh:PropertyGroup ; sh:order 11 ; rdfs:label "On the platform" .

# The PBPK terms of ROBOT's form that schema.org lacks, in the platform's namespace, with ROBOT's labels; each
# applies to the classes it is a field of (schema:domainIncludes), with the kinds of values it takes.
pbpk:analysisType a rdf:Property ; rdfs:label "Analysis type" ;
    schema:domainIncludes pbpk:SUVAnalysis ; schema:rangeIncludes schema:Text .
pbpk:analyzedParameters a rdf:Property ; rdfs:label "Analyzed parameters" ;
    schema:domainIncludes pbpk:SUVAnalysis ; schema:rangeIncludes schema:Text .
pbpk:anatomicalAssumptions a rdf:Property ; rdfs:label "Anatomical assumptions" ;
    schema:domainIncludes pbpk:BiologicalSystem ; schema:rangeIncludes schema:Text .
pbpk:applicabilityDomain a rdf:Property ; rdfs:label "Applicability domain" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes schema:Text .
pbpk:appliesToChemicals a rdf:Property ; rdfs:label "Applicable chemicals" ;
    schema:domainIncludes pbpk:Parameter ; schema:rangeIncludes schema:Text .
pbpk:appliesToCompartments a rdf:Property ; rdfs:label "Applicable compartments" ;
    schema:domainIncludes pbpk:Parameter ; schema:rangeIncludes schema:DefinedTerm .
pbpk:appliesToSpecies a rdf:Property ; rdfs:label "Applicable species" ;
    schema:domainIncludes pbpk:Parameter ; schema:rangeIncludes schema:DefinedTerm .
pbpk:artifactLocation a rdf:Property ; rdfs:label "Artifact location" ;
    schema:domainIncludes schema:MediaObject ; schema:rangeIncludes schema:Text .
pbpk:artifactType a rdf:Property ; rdfs:label "Artifact type" ;
    schema:domainIncludes schema:MediaObject ; schema:rangeIncludes schema:Text .
pbpk:biologicalReference a rdf:Property ; rdfs:label "Biological reference" ;
    schema:domainIncludes pbpk:Compartment ; schema:rangeIncludes schema:DefinedTerm .
pbpk:calibratedParameters a rdf:Property ; rdfs:label "Calibrated parameters" ;
    schema:domainIncludes pbpk:Calibration ; schema:rangeIncludes schema:Text .
pbpk:calibrationData a rdf:Property ; rdfs:label "Calibration data" ;
    schema:domainIncludes pbpk:Calibration ; schema:rangeIncludes schema:Text .
pbpk:chemicalRole a rdf:Property ; rdfs:label "Role in the model" ;
    schema:domainIncludes schema:MolecularEntity ; schema:rangeIncludes schema:Text .
pbpk:compartments a rdf:Property ; rdfs:label "Compartments" ;
    schema:domainIncludes pbpk:BiologicalSystem ; schema:rangeIncludes schema:DefinedTerm .
pbpk:confidenceStatement a rdf:Property ; rdfs:label "Confidence statement" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes schema:Text .
pbpk:connectionType a rdf:Property ; rdfs:label "Connection type" ;
    schema:domainIncludes pbpk:Connection ; schema:rangeIncludes schema:Text .
pbpk:connections a rdf:Property ; rdfs:label "Inter-compartmental connections" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes pbpk:Connection .
pbpk:evaluationData a rdf:Property ; rdfs:label "Evaluation data (reference)" ;
    schema:domainIncludes pbpk:Evaluation ; schema:rangeIncludes schema:Text .
pbpk:hasBiologicalSystem a rdf:Property ; rdfs:label "Biological system(s)" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes pbpk:BiologicalSystem .
pbpk:hasCalibration a rdf:Property ; rdfs:label "Calibration activities" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes pbpk:Calibration .
pbpk:hasChemical a rdf:Property ; rdfs:label "Chemical substance(s)" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes schema:MolecularEntity .
pbpk:hasEvaluation a rdf:Property ; rdfs:label "Evaluation activities" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes pbpk:Evaluation .
pbpk:hasParameter a rdf:Property ; rdfs:label "Parameters" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes pbpk:Parameter .
pbpk:hasSUVAnalysis a rdf:Property ; rdfs:label "SUV analyses" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes pbpk:SUVAnalysis .
pbpk:implementation a rdf:Property ; rdfs:label "Model implementation reference(s)" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes pbpk:Implementation .
pbpk:implementationLocation a rdf:Property ; rdfs:label "Implementation location (relative path)" ;
    schema:domainIncludes pbpk:Implementation ; schema:rangeIncludes schema:Text .
pbpk:implementationType a rdf:Property ; rdfs:label "Implementation type" ;
    schema:domainIncludes pbpk:Implementation ; schema:rangeIncludes schema:Text .
pbpk:intendedUse a rdf:Property ; rdfs:label "Intended use" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes schema:Text .
pbpk:interpretation a rdf:Property ; rdfs:label "Metric interpretation" ;
    schema:domainIncludes pbpk:PerformanceMetric ; schema:rangeIncludes schema:Text .
pbpk:lifeStage a rdf:Property ; rdfs:label "Life stage(s)" ;
    schema:domainIncludes pbpk:BiologicalSystem ; schema:rangeIncludes schema:Text .
pbpk:limitations a rdf:Property ; rdfs:label "Limitations" ;
    schema:domainIncludes pbpk:Evaluation, schema:SoftwareSourceCode ; schema:rangeIncludes schema:Text .
pbpk:mathematicalRepresentation a rdf:Property ; rdfs:label "Mathematical representation" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes schema:Text .
pbpk:method a rdf:Property ; rdfs:label "Method" ;
    schema:domainIncludes pbpk:Calibration, pbpk:Evaluation, pbpk:SUVAnalysis ; schema:rangeIncludes schema:Text .
pbpk:modelStructureDescription a rdf:Property ; rdfs:label "Model structure description" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes schema:Text .
pbpk:notes a rdf:Property ; rdfs:label "Notes" ;
    schema:domainIncludes pbpk:Calibration, pbpk:Parameter, pbpk:SUVAnalysis ; schema:rangeIncludes schema:Text .
pbpk:optimizationCriteria a rdf:Property ; rdfs:label "Optimization criteria" ;
    schema:domainIncludes pbpk:Calibration ; schema:rangeIncludes schema:Text .
pbpk:outcome a rdf:Property ; rdfs:label "Outcome" ;
    schema:domainIncludes pbpk:Evaluation, pbpk:SUVAnalysis ; schema:rangeIncludes schema:Text .
pbpk:parameterCategory a rdf:Property ; rdfs:label "Parameter category" ;
    schema:domainIncludes pbpk:Parameter ; schema:rangeIncludes schema:Text .
pbpk:parameterSource a rdf:Property ; rdfs:label "Parameter source" ;
    schema:domainIncludes pbpk:Parameter ; schema:rangeIncludes schema:Text .
pbpk:performanceMetrics a rdf:Property ; rdfs:label "Performance metrics" ;
    schema:domainIncludes pbpk:Evaluation ; schema:rangeIncludes pbpk:PerformanceMetric .
pbpk:physicochemicalNotes a rdf:Property ; rdfs:label "Physicochemical notes" ;
    schema:domainIncludes schema:MolecularEntity ; schema:rangeIncludes schema:Text .
pbpk:physiologicalScope a rdf:Property ; rdfs:label "Physiological scope" ;
    schema:domainIncludes pbpk:BiologicalSystem ; schema:rangeIncludes schema:Text .
pbpk:populationDescription a rdf:Property ; rdfs:label "Population description" ;
    schema:domainIncludes pbpk:BiologicalSystem ; schema:rangeIncludes schema:Text .
pbpk:reproducibilityInstructions a rdf:Property ; rdfs:label "Reproducibility instructions" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes schema:Text .
pbpk:robustnessInterpretation a rdf:Property ; rdfs:label "Robustness interpretation" ;
    schema:domainIncludes pbpk:SUVAnalysis ; schema:rangeIncludes schema:Text .
pbpk:scope a rdf:Property ; rdfs:label "Parameter scope" ;
    schema:domainIncludes pbpk:Parameter ; schema:rangeIncludes schema:Text .
pbpk:sourceCompartment a rdf:Property ; rdfs:label "Source compartment" ;
    schema:domainIncludes pbpk:Connection ; schema:rangeIncludes schema:Text .
pbpk:sourceReference a rdf:Property ; rdfs:label "Source reference" ;
    schema:domainIncludes pbpk:Parameter ; schema:rangeIncludes schema:Text .
pbpk:species a rdf:Property ; rdfs:label "Species" ;
    schema:domainIncludes pbpk:BiologicalSystem ; schema:rangeIncludes schema:DefinedTerm .
pbpk:structuralCompartments a rdf:Property ; rdfs:label "Structural compartments" ;
    schema:domainIncludes schema:SoftwareSourceCode ; schema:rangeIncludes pbpk:Compartment .
pbpk:targetCompartment a rdf:Property ; rdfs:label "Target compartment" ;
    schema:domainIncludes pbpk:Connection ; schema:rangeIncludes schema:Text .
pbpk:Compartment a rdfs:Class ; rdfs:label "Compartment" .
pbpk:Connection a rdfs:Class ; rdfs:label "Connection" .
pbpk:Implementation a rdfs:Class ; rdfs:label "Implementation" .
pbpk:BiologicalSystem a rdfs:Class ; rdfs:label "Biological system" .
pbpk:Parameter a rdfs:Class ; rdfs:label "Parameter" .
pbpk:Calibration a rdfs:Class ; rdfs:label "Calibration" .
pbpk:Evaluation a rdfs:Class ; rdfs:label "Evaluation" .
pbpk:PerformanceMetric a rdfs:Class ; rdfs:label "Performance metric" .
pbpk:SUVAnalysis a rdfs:Class ; rdfs:label "Sensitivity, uncertainty or variability analysis" .

# A computational model, at /models/<name>, with the fields of ROBOT's PBPK form and its links on the platform;
# its RO-Crate is made from it (/models/<name>/ro-crate-metadata.json).
form:SoftwareSourceCode a sh:NodeShape ;
    sh:targetClass schema:SoftwareSourceCode ;
    rdfs:label "Model" ;
    sh:property [ sh:path schema:name ; sh:group form:modelGeneral ; sh:order 1 ; sh:name "Model name" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the model name, as ROBOT asks." ] ;
    sh:property [ sh:path schema:version ; sh:group form:modelGeneral ; sh:order 2 ; sh:name "Model version" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the model version, as ROBOT asks." ] ;
    sh:property [ sh:path schema:description ; sh:group form:modelGeneral ; sh:order 3 ; sh:name "Model description" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the model description, as ROBOT asks." ] ;
    sh:property [ sh:path schema:creator ; sh:group form:modelGeneral ; sh:order 4 ; sh:name "Model author(s)" ; sh:minCount 1 ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ; sh:severity sh:Warning ; sh:message "Add the model author(s), as ROBOT asks." ] ;
    sh:property [ sh:path schema:programmingLanguage ; sh:group form:modelGeneral ; sh:order 5 ; sh:name "Software platform" ; sh:minCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "SBML" "Python" "R" "MATLAB" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path schema:codeRepository ; sh:group form:modelGeneral ; sh:order 6 ; sh:name "Model availability (URLs/DOIs)" ; sh:minCount 1 ;
        sh:nodeKind sh:IRI ; sh:severity sh:Warning ; sh:message "Add the model availability (URLs/DOIs), as ROBOT asks." ] ;
    sh:property [ sh:path schema:license ; sh:group form:modelGeneral ; sh:order 7 ; sh:name "License" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ; sh:pattern "^https://spdx\\.org/licenses/" ; form:publishedAs schema:CreativeWork ; sh:message "Add the license, chosen from SPDX; other values are kept." ] ;
    sh:property [ sh:path schema:applicationCategory ; sh:group form:modelGeneral ; sh:order 8 ; sh:name "Intended application category" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the intended application category, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:modelStructureDescription ; sh:group form:modelModelStructure ; sh:order 1 ; sh:name "Model structure description" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the model structure description, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:structuralCompartments ; sh:group form:modelModelStructure ; sh:order 2 ; sh:name "Structural compartments" ; sh:minCount 1 ;
        sh:class pbpk:Compartment ; sh:node form:Compartment ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add the structural compartments, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:connections ; sh:group form:modelModelStructure ; sh:order 3 ; sh:name "Inter-compartmental connections" ; sh:minCount 1 ;
        sh:class pbpk:Connection ; sh:node form:Connection ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add the inter-compartmental connections, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:mathematicalRepresentation ; sh:group form:modelModelStructure ; sh:order 4 ; sh:name "Mathematical representation" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Ordinary differential equations" "Algebraic equations" "Hybrid ODE-algebraic system" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path pbpk:implementation ; sh:group form:modelModelStructure ; sh:order 5 ; sh:name "Model implementation reference(s)" ; sh:minCount 1 ;
        sh:class pbpk:Implementation ; sh:node form:Implementation ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add the model implementation reference(s), as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:hasChemical ; sh:group form:modelChemicals ; sh:order 1 ; sh:name "Chemical substance(s)" ; sh:minCount 1 ;
        sh:class schema:MolecularEntity ; sh:node form:MolecularEntity ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add the chemical substance(s), as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:hasBiologicalSystem ; sh:group form:modelBiologicalSystem ; sh:order 1 ; sh:name "Biological system(s)" ; sh:minCount 1 ;
        sh:class pbpk:BiologicalSystem ; sh:node form:BiologicalSystem ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add the biological system(s), as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:hasParameter ; sh:group form:modelParameterization ; sh:order 1 ; sh:name "Parameters" ; sh:minCount 1 ;
        sh:class pbpk:Parameter ; sh:node form:Parameter ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add the parameters, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:hasCalibration ; sh:group form:modelCalibration ; sh:order 1 ; sh:name "Calibration activities" ;
        sh:class pbpk:Calibration ; sh:node form:Calibration ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path pbpk:hasEvaluation ; sh:group form:modelValidation ; sh:order 1 ; sh:name "Evaluation activities" ; sh:minCount 1 ;
        sh:class pbpk:Evaluation ; sh:node form:Evaluation ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add the evaluation activities, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:hasSUVAnalysis ; sh:group form:modelUncertainty ; sh:order 1 ; sh:name "SUV analyses" ;
        sh:class pbpk:SUVAnalysis ; sh:node form:SUVAnalysis ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path pbpk:intendedUse ; sh:group form:modelApplicability ; sh:order 1 ; sh:name "Intended use" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the intended use, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:applicabilityDomain ; sh:group form:modelApplicability ; sh:order 2 ; sh:name "Applicability domain" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the applicability domain, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:confidenceStatement ; sh:group form:modelApplicability ; sh:order 3 ; sh:name "Confidence statement" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the confidence statement, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:limitations ; sh:group form:modelApplicability ; sh:order 4 ; sh:name "Known limitations" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the known limitations, as ROBOT asks." ] ;
    sh:property [ sh:path schema:hasPart ; sh:group form:modelElectronicFiles ; sh:order 1 ; sh:name "Digital artifacts" ; sh:minCount 1 ;
        sh:class schema:MediaObject ; sh:node form:MediaObject ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add the digital artifacts, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:reproducibilityInstructions ; sh:group form:modelElectronicFiles ; sh:order 2 ; sh:name "Reproducibility instructions" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the reproducibility instructions, as ROBOT asks." ] ;
    sh:property [ sh:path schema:contributor ; sh:group form:modelLinks ; sh:order 1 ; sh:name "Contributors" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ] ;
    sh:property [ sh:path schema:citation ; sh:group form:modelLinks ; sh:order 2 ; sh:name "Publications" ; sh:class schema:ScholarlyArticle ;
        sh:description "The publications that describe the model; their pages link to their DOIs." ] ;
    sh:property [ sh:path schema:funding ; sh:group form:modelLinks ; sh:order 3 ; sh:name "Funded by" ; sh:class schema:MonetaryGrant ] ;
    sh:property [ sh:path schema:about ; sh:group form:modelLinks ; sh:order 4 ; sh:name "Topics" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose an ontology term, or register it." ;
        sh:description "What the model deals with, such as its chemicals (ChEBI) and organisms." ] ;
    sh:property [ sh:path schema:keywords ; sh:group form:modelLinks ; sh:order 5 ; sh:name "Keywords" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it; text is kept until then." ] ;
    sh:property [ sh:path glossary:VHP0000152 ; sh:group form:modelLinks ; sh:order 6 ; sh:name "Assessment steps" ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:in ( glossary:VHP0000153 glossary:VHP0000154 glossary:VHP0000155 glossary:VHP0000156 glossary:VHP0000158 ) ;
        sh:message "Choose from the list; other values are not in the filters." ] ;
    sh:property [ sh:path glossary:VHP0000151 ; sh:group form:modelLinks ; sh:order 7 ; sh:name "Case-study questions" ; sh:class schema:HowTo ] ;
    sh:property [ sh:path schema:runtimePlatform ; sh:group form:modelLinks ; sh:order 8 ; sh:name "Runtime" ; sh:datatype xsd:string ;
        sh:description "Such as R 4.1.0, or Berkeley Madonna 10.6.1." ] ;
    sh:property [ sh:path schema:softwareRequirements ; sh:group form:modelLinks ; sh:order 9 ; sh:name "Requirements" ; sh:datatype xsd:string ;
        sh:description "Packages the model needs, with their versions." ] ;
    sh:property [ sh:path schema:datePublished ; sh:group form:modelLinks ; sh:order 10 ; sh:name "Published" ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path schema:isBasedOn ; sh:group form:modelLinks ; sh:order 11 ; sh:name "Source record" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "The Zenodo record this one is made from." ] ;
    sh:property [ sh:path schema:sameAs ; sh:group form:modelLinks ; sh:order 12 ; sh:name "DOI and other addresses" ; sh:nodeKind sh:IRI ] .

# Compartment: part of a model's record.
form:Compartment a sh:NodeShape ;
    sh:targetClass pbpk:Compartment ;
    rdfs:label "Compartment" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Compartment name (model)" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the compartment name (model), as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:biologicalReference ; sh:order 2 ; sh:name "Biological reference" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ; sh:message "Choose an ontology term, or register it; text is kept until then." ] ;
    sh:property [ sh:path schema:description ; sh:order 3 ; sh:name "Compartment description" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] .

# Connection: part of a model's record.
form:Connection a sh:NodeShape ;
    sh:targetClass pbpk:Connection ;
    rdfs:label "Connection" ;
    sh:property [ sh:path pbpk:sourceCompartment ; sh:order 1 ; sh:name "Source compartment" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the source compartment, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:targetCompartment ; sh:order 2 ; sh:name "Target compartment" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the target compartment, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:connectionType ; sh:order 3 ; sh:name "Connection type" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Blood flow" "Diffusion" "Permeation" "Other" ) ; sh:message "Choose from the list; other values are kept." ] .

# Implementation: part of a model's record.
form:Implementation a sh:NodeShape ;
    sh:targetClass pbpk:Implementation ;
    rdfs:label "Implementation" ;
    sh:property [ sh:path pbpk:implementationType ; sh:order 1 ; sh:name "Implementation type" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "SBML" "Python script" "R script" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path pbpk:implementationLocation ; sh:order 2 ; sh:name "Implementation location (relative path)" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the implementation location (relative path), as ROBOT asks." ] .

# Chemical: part of a model's record.
form:MolecularEntity a sh:NodeShape ;
    sh:targetClass schema:MolecularEntity ;
    rdfs:label "Chemical" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Chemical name" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the chemical name, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:chemicalRole ; sh:order 2 ; sh:name "Role in the model" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Parent compound" "Metabolite" "Co-exposure component" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path schema:identifier ; sh:order 3 ; sh:name "Chemical identifier(s)" ; sh:minCount 1 ;
        sh:class schema:PropertyValue ; sh:node form:PropertyValue ; sh:nodeKind sh:BlankNode ; sh:severity sh:Warning ; sh:message "Add the chemical identifier(s), as ROBOT asks." ] ;
    sh:property [ sh:path schema:molecularWeight ; sh:order 4 ; sh:name "Molecular weight (g/mol)" ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ] ;
    sh:property [ sh:path pbpk:physicochemicalNotes ; sh:order 5 ; sh:name "Physicochemical notes" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] .

# Identifier or value: part of a model's record.
form:PropertyValue a sh:NodeShape ;
    sh:targetClass schema:PropertyValue ;
    rdfs:label "Identifier or value" ;
    sh:property [ sh:path schema:propertyID ; sh:order 1 ; sh:name "Identifier type" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "CAS RN" "InChI" "InChIKey" "SMILES" "PubChem CID" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path schema:value ; sh:order 2 ; sh:name "Identifier value" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the identifier value, as ROBOT asks." ] .

# Biological system: part of a model's record.
form:BiologicalSystem a sh:NodeShape ;
    sh:targetClass pbpk:BiologicalSystem ;
    rdfs:label "Biological system" ;
    sh:property [ sh:path pbpk:species ; sh:order 1 ; sh:name "Species" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ; sh:message "Choose an ontology term, or register it; text is kept until then." ] ;
    sh:property [ sh:path pbpk:lifeStage ; sh:order 2 ; sh:name "Life stage(s)" ; sh:minCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Adult" "Juvenile" "Neonate" "Pregnant" "Lactating" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path pbpk:physiologicalScope ; sh:order 3 ; sh:name "Physiological scope" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the physiological scope, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:compartments ; sh:order 4 ; sh:name "Compartments" ; sh:minCount 1 ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ; sh:message "Choose an ontology term, or register it; text is kept until then." ] ;
    sh:property [ sh:path pbpk:populationDescription ; sh:order 5 ; sh:name "Population description" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] ;
    sh:property [ sh:path pbpk:anatomicalAssumptions ; sh:order 6 ; sh:name "Anatomical assumptions" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] .

# Parameter: part of a model's record.
form:Parameter a sh:NodeShape ;
    sh:targetClass pbpk:Parameter ;
    rdfs:label "Parameter" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Parameter name" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the parameter name, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:parameterCategory ; sh:order 2 ; sh:name "Parameter category" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Physiological" "Biochemical" "Physicochemical" "Empirical" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path schema:value ; sh:order 3 ; sh:name "Parameter value" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ; sh:severity sh:Warning ; sh:message "Add the parameter value, as ROBOT asks." ] ;
    sh:property [ sh:path schema:unitText ; sh:order 4 ; sh:name "Parameter unit" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the parameter unit, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:scope ; sh:order 5 ; sh:name "Parameter scope" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Global" "Species-specific" "Compartment-specific" "Chemical-specific" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path pbpk:appliesToSpecies ; sh:order 6 ; sh:name "Applicable species" ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ; sh:message "Choose an ontology term, or register it; text is kept until then." ] ;
    sh:property [ sh:path pbpk:appliesToCompartments ; sh:order 7 ; sh:name "Applicable compartments" ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ; sh:message "Choose an ontology term, or register it; text is kept until then." ] ;
    sh:property [ sh:path pbpk:appliesToChemicals ; sh:order 8 ; sh:name "Applicable chemicals" ;
        sh:datatype xsd:string ] ;
    sh:property [ sh:path pbpk:parameterSource ; sh:order 9 ; sh:name "Parameter source" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Literature" "Experimental data" "In silico estimation" "Assumed" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path pbpk:sourceReference ; sh:order 10 ; sh:name "Source reference" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] ;
    sh:property [ sh:path pbpk:notes ; sh:order 11 ; sh:name "Parameter notes" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] .

# Calibration: part of a model's record.
form:Calibration a sh:NodeShape ;
    sh:targetClass pbpk:Calibration ;
    rdfs:label "Calibration" ;
    sh:property [ sh:path schema:description ; sh:order 1 ; sh:name "Calibration description" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the calibration description, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:method ; sh:order 2 ; sh:name "Calibration method" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Manual fitting" "Least squares optimization" "Bayesian inference" "Visual inspection" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path pbpk:calibrationData ; sh:order 3 ; sh:name "Calibration data" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] ;
    sh:property [ sh:path pbpk:calibratedParameters ; sh:order 4 ; sh:name "Calibrated parameters" ;
        sh:datatype xsd:string ] ;
    sh:property [ sh:path pbpk:optimizationCriteria ; sh:order 5 ; sh:name "Optimization criteria" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] ;
    sh:property [ sh:path pbpk:notes ; sh:order 6 ; sh:name "Calibration notes" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] .

# Evaluation: part of a model's record.
form:Evaluation a sh:NodeShape ;
    sh:targetClass pbpk:Evaluation ;
    rdfs:label "Evaluation" ;
    sh:property [ sh:path schema:description ; sh:order 1 ; sh:name "Evaluation description" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the evaluation description, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:evaluationData ; sh:order 2 ; sh:name "Evaluation data (reference)" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] ;
    sh:property [ sh:path pbpk:method ; sh:order 3 ; sh:name "Evaluation method" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Visual comparison" "Statistical goodness-of-fit" "Observed vs predicted regression" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path pbpk:performanceMetrics ; sh:order 4 ; sh:name "Performance metrics" ;
        sh:class pbpk:PerformanceMetric ; sh:node form:PerformanceMetric ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path pbpk:outcome ; sh:order 5 ; sh:name "Evaluation outcome" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the evaluation outcome, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:limitations ; sh:order 6 ; sh:name "Evaluation limitations" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] .

# Performance metric: part of a model's record.
form:PerformanceMetric a sh:NodeShape ;
    sh:targetClass pbpk:PerformanceMetric ;
    rdfs:label "Performance metric" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Metric name" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the metric name, as ROBOT asks." ] ;
    sh:property [ sh:path schema:value ; sh:order 2 ; sh:name "Metric value" ; sh:maxCount 1 ;
        sh:datatype xsd:string ] ;
    sh:property [ sh:path pbpk:interpretation ; sh:order 3 ; sh:name "Metric interpretation" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] .

# Sensitivity, uncertainty or variability analysis: part of a model's record.
form:SUVAnalysis a sh:NodeShape ;
    sh:targetClass pbpk:SUVAnalysis ;
    rdfs:label "Sensitivity, uncertainty or variability analysis" ;
    sh:property [ sh:path pbpk:analysisType ; sh:order 1 ; sh:name "Analysis type" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Sensitivity analysis" "Uncertainty analysis" "Variability analysis" "Combined analysis" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path pbpk:method ; sh:order 2 ; sh:name "Analysis method" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] ;
    sh:property [ sh:path pbpk:analyzedParameters ; sh:order 3 ; sh:name "Analyzed parameters" ;
        sh:datatype xsd:string ] ;
    sh:property [ sh:path pbpk:outcome ; sh:order 4 ; sh:name "Analysis results" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ; sh:severity sh:Warning ; sh:message "Add the analysis results, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:robustnessInterpretation ; sh:order 5 ; sh:name "Robustness interpretation" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] ;
    sh:property [ sh:path pbpk:notes ; sh:order 6 ; sh:name "Additional notes" ; sh:maxCount 1 ;
        sh:or ( form:PlainText form:HTMLText ) ; dash:singleLine false ] .

# File: part of a model's record.
form:MediaObject a sh:NodeShape ;
    sh:targetClass schema:MediaObject ;
    rdfs:label "File" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Artifact name" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the artifact name, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:artifactType ; sh:order 2 ; sh:name "Artifact type" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:in ( "Model code" "Simulation script" "Parameter file" "Dataset" "Documentation" "Notebook" "Other" ) ; sh:message "Choose from the list; other values are kept." ] ;
    sh:property [ sh:path schema:encodingFormat ; sh:order 3 ; sh:name "Artifact format" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the artifact format, as ROBOT asks." ] ;
    sh:property [ sh:path pbpk:artifactLocation ; sh:order 4 ; sh:name "Artifact location" ; sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ; sh:severity sh:Warning ; sh:message "Add the artifact location, as ROBOT asks." ] .
