# The platform's application profile: what it adds to schema.org and Bioschemas.
#
# Each class has one node shape, named after it; its property shapes are the fields of its records.
# The editor's form, the pages and the linked data view are built from them alone; the vocabularies'
# value types only check values.
# - sh:group, sh:order, sh:name: a field's section, place and label. sh:description: its help.
# - sh:datatype: a text, a number or a date (xsd:date is picked in a calendar).
# - sh:nodeKind sh:IRI: a web address. sh:in: one of a list.
# - sh:class: a link to a record of a class; with sh:pattern, a term of one vocabulary only.
# - sh:or: a choice between classes. Records are found by name, or a new one is added.
# - sh:node: parts written with the record: without an address (sh:nodeKind sh:BlankNode), such as
#   page sections, or under the record's address (sh:nodeKind sh:IRI), such as case study questions.
# - sh:minCount: required; with sh:severity sh:Warning, recommended (shown, but a save is not stopped).
# - sh:hasValue: a fixed value. dash:singleLine false: a longer text.
# - sh:message: shown when a value is missing or does not fit.
# - form:private true: kept off the pages and their data; editors see it.
# - form:publishedAs: a class its values also have on the pages and their data, as schema.org expects (a
#   licence is a CreativeWork); the records keep their own.
# The required fields of tools are the minimum of the Bioschemas ComputationalTool profile.

@prefix schema: <https://schema.org/> .
@prefix bioschemas_draft: <https://bioschemas.org/draft_terms/> .
@prefix bioschemas: <https://bioschemas.org/terms/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix form: <https://platform.vhp4safety.nl/model/v1/form#> .
@prefix glossary: <https://vhp4safety.github.io/glossary#> .
@prefix wd: <http://www.wikidata.org/entity/> .

form:about a sh:PropertyGroup ; sh:order 1 ; rdfs:label "About the tool" .
form:method a sh:PropertyGroup ; sh:order 1 ; rdfs:label "About the method" .
form:assay a sh:PropertyGroup ; sh:order 2 ; rdfs:label "Assay" .
form:people a sh:PropertyGroup ; sh:order 2 ; rdfs:label "People" .
form:documentation a sh:PropertyGroup ; sh:order 3 ; rdfs:label "Documentation and training" .
form:technical a sh:PropertyGroup ; sh:order 4 ; rdfs:label "Technical details" .
form:elsewhere a sh:PropertyGroup ; sh:order 5 ; rdfs:label "Elsewhere on the web" .
form:casestudy a sh:PropertyGroup ; sh:order 1 ; rdfs:label "About the case study" .
form:workflow a sh:PropertyGroup ; sh:order 1 ; rdfs:label "Workflow page" .
form:parts a sh:PropertyGroup ; sh:order 2 ; rdfs:label "Parts" .

# A text is plain, or HTML (rdf:HTML) when it has markup such as <p> or <b>.
form:PlainText a sh:NodeShape ; rdfs:label "Text" ; sh:datatype xsd:string ; sh:not [ sh:pattern "<\\s*/?[a-zA-Z][^>]*>" ] .
form:HTMLText a sh:NodeShape ; rdfs:label "HTML" ; sh:datatype rdf:HTML .

form:SoftwareApplication a sh:NodeShape ;
    sh:targetClass schema:SoftwareApplication ;
    rdfs:label "Tool" ;
    rdfs:comment "Tools state their Bioschemas profile (ComputationalTool)." ;
    sh:property [
        sh:path schema:name ; sh:group form:about ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "As its developers write it." ;
        sh:message "One name needed." ] ;
    sh:property [
        sh:path schema:description ; sh:group form:about ; sh:order 2 ; sh:name "Description" ; sh:minCount 1 ; sh:maxCount 1 ;
        dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "What the tool does, in two or three sentences. Shown in the catalogue and on the tool's page." ;
        sh:message "One description needed." ] ;
    sh:property [
        sh:path schema:url ; sh:group form:about ; sh:order 3 ; sh:name "Website" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:severity sh:Warning ;
        sh:description "Website or documentation." ;
        sh:message "Add the website, if any." ] ;
    sh:property [
        sh:path schema:installUrl ; sh:group form:about ; sh:order 4 ; sh:name "Where to use it" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "Where the tool runs, if not its website. Linked as \"Run the tool\"." ] ;
    sh:property [
        sh:path schema:image ; sh:group form:about ; sh:order 5 ; sh:name "Logo or screenshot" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "Shown on the tool's card in the catalogue." ] ;
    sh:property [
        sh:path glossary:VHP0000152 ; sh:group form:about ; sh:order 6 ; sh:name "Assessment steps" ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:in ( glossary:VHP0000153 glossary:VHP0000154 glossary:VHP0000155 glossary:VHP0000156 glossary:VHP0000158 ) ;
        sh:message "Choose from the list; other values are not in the filters." ;
        sh:description "Process flow steps the tool supports; the catalogue is filtered by them." ] ;
    sh:property [
        sh:path glossary:VHP0000151 ; sh:group form:about ; sh:order 7 ; sh:name "Case-study questions" ;
        sh:class schema:HowTo ;
        sh:description "Case study questions the tool helps answer; the catalogue is filtered by them." ] ;
    sh:property [
        sh:path schema:about ; sh:group form:about ; sh:order 8 ; sh:name "Topics" ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it." ;
        sh:description "What the tool deals with, such as Model or Adverse Outcome Pathway." ] ;
    sh:property [
        sh:path schema:provider ; sh:group form:people ; sh:order 1 ; sh:name "Provided by" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ;
        sh:description "Who offers the tool. VHP4Safety, when it runs on the platform's servers, is shown as its host." ] ;
    sh:property [
        sh:path schema:creator ; sh:group form:people ; sh:order 2 ; sh:name "Developed by" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ;
        sh:description "Who developed the tool; VHP4Safety when the project did." ] ;
    sh:property [
        sh:path schema:maintainer ; sh:group form:people ; sh:order 3 ; sh:name "Contact people" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ;
        sh:description "Who to contact. Names and email addresses are shown on the support tab." ] ;
    sh:property [
        sh:path schema:softwareHelp ; sh:group form:documentation ; sh:order 1 ; sh:name "Guides and demos" ;
        sh:class schema:WebPage ; sh:node form:WebPage ; sh:nodeKind sh:BlankNode ;
        sh:description "Introductions, tutorials, demos and deployment guides, each with a title." ] ;
    sh:property [
        sh:path schema:subjectOf ; sh:group form:documentation ; sh:order 2 ; sh:name "Used in workflows" ;
        sh:class schema:WebPage ; sh:node form:WebPage ; sh:nodeKind sh:BlankNode ;
        sh:description "VHP4Safety workflows and tutorials that use the tool, each with a title." ] ;
    sh:property [
        sh:path schema:video ; sh:group form:documentation ; sh:order 3 ; sh:name "Videos" ;
        sh:class schema:VideoObject ; sh:node form:VideoObject ; sh:nodeKind sh:BlankNode ;
        sh:description "Videos shown on its page, such as PeerTube ones, each with a title." ] ;
    sh:property [
        sh:path schema:citation ; sh:group form:documentation ; sh:order 4 ; sh:name "Publication to cite" ; sh:maxCount 1 ;
        sh:class schema:ScholarlyArticle ;
        sh:description "The publication to cite when the tool is used; its page links to its DOI." ] ;
    sh:property [
        sh:path schema:keywords ; sh:group form:documentation ; sh:order 5 ; sh:name "Training search term" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "Searched on ELIXIR TeSS and Taxila; the results are shown on the tool's page." ] ;
    sh:property [
        sh:path schema:softwareVersion ; sh:group form:technical ; sh:order 1 ; sh:name "Version" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "As its developers number it." ] ;
    sh:property [
        sh:path schema:license ; sh:group form:technical ; sh:order 2 ; sh:name "License" ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ; sh:pattern "^https://spdx\\.org/licenses/" ; form:publishedAs schema:CreativeWork ;
        sh:message "Choose an SPDX license; other values are kept." ;
        sh:description "The tool's license." ] ;
    sh:property [
        sh:path schema:isBasedOn ; sh:group form:technical ; sh:order 3 ; sh:name "Source code" ; sh:nodeKind sh:IRI ;
        sh:description "Its repository, such as on GitHub." ] ;
    sh:property [
        sh:path schema:downloadUrl ; sh:group form:technical ; sh:order 4 ; sh:name "Downloads" ; sh:nodeKind sh:IRI ;
        sh:description "Container images or software packages." ] ;
    sh:property [
        sh:path schema:creativeWorkStatus ; sh:group form:technical ; sh:order 5 ; sh:name "Technology readiness" ; sh:maxCount 1 ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ;
        sh:in ( wd:Q120669280 wd:Q120669304 wd:Q120669316 wd:Q120669327 wd:Q120669340 wd:Q120669350 wd:Q120669358 wd:Q120669370 wd:Q120669377 ) ;
        sh:description "From TRL 1 (basic principles observed) to TRL 9 (proven in its operational environment)." ;
        sh:message "Choose a level from TRL 1 to TRL 9; text is kept." ] ;
    sh:property [
        sh:path schema:releaseNotes ; sh:group form:technical ; sh:order 6 ; sh:name "Release notes" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "Address of the release notes, or a short note on the latest release." ] ;
    sh:property [
        sh:path schema:sameAs ; sh:group form:elsewhere ; sh:order 1 ; sh:name "Other addresses" ; sh:nodeKind sh:IRI ;
        sh:description "Such as bio.tools, FAIRsharing, Wikipedia or the Research Software Directory. Earlier platform addresses are kept here, so old links still work." ] ;
    sh:property [
        sh:path dct:conformsTo ; sh:group form:elsewhere ; sh:order 2 ; sh:name "Bioschemas profile" ; sh:nodeKind sh:IRI ;
        sh:hasValue <https://bioschemas.org/profiles/ComputationalTool/1.0-RELEASE> ;
        sh:description "Bioschemas ComputationalTool 1.0, read by search engines and registries." ;
        sh:message "ComputationalTool 1.0-RELEASE expected." ] .

form:Organization a sh:NodeShape ;
    sh:targetClass schema:Organization ;
    rdfs:label "Organisation" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:url ; sh:order 2 ; sh:name "Website" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 3 ; sh:name "Elsewhere" ; sh:nodeKind sh:IRI ;
        sh:description "Its Wikidata or ROR item, and other addresses." ] .

form:Person a sh:NodeShape ;
    sh:targetClass schema:Person ;
    rdfs:label "Person" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:email ; sh:order 2 ; sh:name "Email address" ; sh:maxCount 1 ; sh:datatype xsd:string ; form:private true ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 3 ; sh:name "Elsewhere" ; sh:nodeKind sh:IRI ;
        sh:description "ORCID iD or Wikidata item, as a web address." ] ;
    sh:property [ sh:path schema:affiliation ; sh:order 4 ; sh:name "Affiliation" ; sh:class schema:Organization ] .

form:LabProtocol a sh:NodeShape ;
    sh:targetClass bioschemas_draft:LabProtocol ;
    rdfs:label "Method" ;
    rdfs:comment "Methods state their Bioschemas profile (LabProtocol)." ;
    sh:property [
        sh:path schema:name ; sh:group form:method ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "As known in the lab." ;
        sh:message "One name needed." ] ;
    sh:property [
        sh:path schema:description ; sh:group form:method ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ;
        dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "What the method measures or shows, in one or two sentences." ] ;
    sh:property [
        sh:path glossary:VHP0000152 ; sh:group form:method ; sh:order 3 ; sh:name "Assessment steps" ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:in ( glossary:VHP0000153 glossary:VHP0000154 glossary:VHP0000155 glossary:VHP0000156 glossary:VHP0000158 ) ;
        sh:message "Choose from the list; other values are not in the filters." ;
        sh:description "Process flow steps the method informs." ] ;
    sh:property [
        sh:path glossary:VHP0000151 ; sh:group form:method ; sh:order 4 ; sh:name "Case-study questions" ;
        sh:class schema:HowTo ;
        sh:description "Case study questions the method informs." ] ;
    sh:property [
        sh:path schema:about ; sh:group form:method ; sh:order 5 ; sh:name "Key events, pathways and topics" ;
        sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a term, such as an AOP-Wiki key event, or register it." ;
        sh:description "AOP-Wiki key events and pathways the method measures, and glossary terms." ] ;
    sh:property [
        sh:path schema:additionalType ; sh:group form:method ; sh:order 6 ; sh:name "Kind of assay" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a term, such as from BAO or OBI, or register it." ;
        sh:description "The kind of assay, as OBI or BAO terms." ] ;
    sh:property [
        sh:path schema:alternateName ; sh:group form:assay ; sh:order 1 ; sh:name "Assay name" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "The assay or kit name, as its vendor gives it." ] ;
    sh:property [
        sh:path schema:provider ; sh:group form:assay ; sh:order 2 ; sh:name "Vendor" ;
        sh:class schema:Organization ;
        sh:description "The company that sells the assay or kit." ] ;
    sh:property [
        sh:path schema:identifier ; sh:group form:assay ; sh:order 3 ; sh:name "Catalogue number" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "The vendor's catalogue number." ] ;
    sh:property [
        sh:path schema:url ; sh:group form:assay ; sh:order 4 ; sh:name "Product page" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "The vendor's page." ] ;
    sh:property [
        sh:path schema:creator ; sh:group form:people ; sh:order 1 ; sh:name "Data producer" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ;
        sh:description "Who produces data with the method in VHP4Safety." ] ;
    sh:property [
        sh:path schema:citation ; sh:group form:documentation ; sh:order 1 ; sh:name "Publications" ;
        sh:class schema:ScholarlyArticle ;
        sh:description "Publications on the method; their pages link to their DOIs." ] ;
    sh:property [
        sh:path schema:subjectOf ; sh:group form:documentation ; sh:order 2 ; sh:name "Standard operating procedure" ; sh:nodeKind sh:IRI ;
        sh:description "The protocol the lab follows." ] ;
    sh:property [
        sh:path schema:isBasedOn ; sh:group form:elsewhere ; sh:order 1 ; sh:name "Catalogue request" ; sh:nodeKind sh:IRI ;
        sh:description "The cloud catalogue request the record was made from." ] ;
    sh:property [
        sh:path dct:conformsTo ; sh:group form:elsewhere ; sh:order 2 ; sh:name "Bioschemas profile" ; sh:nodeKind sh:IRI ;
        sh:hasValue <https://bioschemas.org/profiles/LabProtocol/0.9-DRAFT> ;
        sh:message "LabProtocol 0.9-DRAFT expected." ] .

# A case study, at /casestudies/<case>, with its regulatory questions (Bioschemas Study, a CreativeWork).
form:Study a sh:NodeShape ;
    sh:targetClass bioschemas_draft:Study ;
    rdfs:label "Case study" ;
    sh:property [ sh:path schema:name ; sh:group form:casestudy ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:description ; sh:group form:casestudy ; sh:order 2 ; sh:name "Aim" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "In one sentence." ] ;
    sh:property [ sh:path schema:about ; sh:group form:casestudy ; sh:order 3 ; sh:name "Condition" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a SNOMED CT or MONDO term, or register it." ;
        sh:description "The medical condition, as a SNOMED or MONDO term." ] ;
    sh:property [ sh:path schema:keywords ; sh:group form:casestudy ; sh:order 4 ; sh:name "Keywords" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it; text is kept until then." ;
        sh:description "What the case study deals with." ] ;
    sh:property [ sh:path schema:abstract ; sh:group form:casestudy ; sh:order 5 ; sh:name "Introduction to the questions" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:text ; sh:group form:casestudy ; sh:order 6 ; sh:name "Text" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "The page's text in HTML, when not in sections." ] ;
    sh:property [ sh:path schema:hasPart ; sh:group form:parts ; sh:order 1 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNode ;
        sh:description "Page sections, each with a heading, an HTML text and a position." ] ;
    sh:property [ sh:path glossary:VHP0000151 ; sh:group form:parts ; sh:order 2 ; sh:name "Regulatory questions" ;
        sh:class schema:HowTo ; sh:node form:HowTo ; sh:nodeKind sh:IRI ;
        sh:description "Each at /casestudies/<case>/<question>, with its workflow's steps." ] .

# A page of a case study's workflow: a regulatory question, at /casestudies/<case>/<question>, or a process flow
# step or part of one, at an address under its parent page; with its steps, tools, data and text. It is part
# of its case study's record.
form:HowTo a sh:NodeShape ;
    sh:targetClass schema:HowTo ;
    rdfs:label "Workflow page" ;
    sh:property [ sh:path schema:name ; sh:group form:workflow ; sh:order 1 ; sh:name "Title" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One title needed." ] ;
    sh:property [ sh:path schema:text ; sh:group form:workflow ; sh:order 2 ; sh:name "Text" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ;
        sh:description "A question's wording; on other pages, the page's text in HTML, when not in sections." ] ;
    sh:property [ sh:path schema:headline ; sh:group form:workflow ; sh:order 3 ; sh:name "Heading of its page" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:group form:workflow ; sh:order 4 ; sh:name "Summary" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:about ; sh:group form:workflow ; sh:order 5 ; sh:name "Glossary term" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:pattern "^https://vhp4safety\\.github\\.io/glossary#" ;
        sh:message "Choose a glossary term, such as Toxicokinetics (Process Flow Step)." ;
        sh:description "A process flow step, or a part of one." ] ;
    sh:property [ sh:path schema:creativeWorkStatus ; sh:group form:workflow ; sh:order 6 ; sh:name "Status" ; sh:maxCount 1 ; sh:datatype xsd:string ;
        sh:description "\"disabled\": the button is shown but cannot be opened yet." ] ;
    sh:property [ sh:path schema:position ; sh:group form:workflow ; sh:order 7 ; sh:name "Position" ; sh:maxCount 1 ; sh:datatype xsd:integer ;
        sh:description "Button order on the parent page; 1 is first." ] ;
    sh:property [ sh:path schema:hasPart ; sh:group form:parts ; sh:order 1 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNode ;
        sh:description "Page sections, each with a heading, an HTML text and a position." ] ;
    sh:property [ sh:path schema:step ; sh:group form:parts ; sh:order 2 ; sh:name "Steps" ;
        sh:class schema:HowTo ; sh:node form:HowTo ; sh:nodeKind sh:IRI ;
        sh:description "Each a page under this page's address; a question's are its process flow steps." ] ;
    sh:property [ sh:path schema:tool ; sh:group form:parts ; sh:order 3 ; sh:name "Tools and methods" ; sh:nodeKind sh:IRI ;
        sh:or ( [ sh:class schema:SoftwareApplication ; rdfs:label "Tool" ] [ sh:class bioschemas_draft:LabProtocol ; rdfs:label "Method" ] ) ;
        form:publishedAs schema:HowToTool ;
        sh:message "Link a tool or method." ;
        sh:description "Tools and methods the page uses; names and descriptions come from their records." ] ;
    sh:property [ sh:path schema:supply ; sh:group form:parts ; sh:order 4 ; sh:name "Data" ; sh:nodeKind sh:IRI ; sh:class schema:Dataset ;
        form:publishedAs schema:HowToSupply ;
        sh:message "Link a dataset." ;
        sh:description "Datasets the page uses; names and descriptions come from their records." ] ;
    sh:property [ sh:path bioschemas:input ; sh:group form:parts ; sh:order 5 ; sh:name "Input" ;
        sh:class bioschemas:FormalParameter ; sh:node form:FormalParameter ; sh:nodeKind sh:BlankNode ;
        sh:description "What a step takes, such as an estimated daily intake." ] ;
    sh:property [ sh:path bioschemas:output ; sh:group form:parts ; sh:order 6 ; sh:name "Output" ;
        sh:class bioschemas:FormalParameter ; sh:node form:FormalParameter ; sh:nodeKind sh:BlankNode ;
        sh:description "What a step gives, such as an exposure calculation." ] .

# A workflow step (the value of a schema:step) is expected to state its input and output.
form:WorkflowStep a sh:NodeShape ;
    sh:targetObjectsOf schema:step ;
    rdfs:label "Workflow step" ;
    sh:property [ sh:path bioschemas:input ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "Add the input." ] ;
    sh:property [ sh:path bioschemas:output ; sh:minCount 1 ; sh:severity sh:Warning ; sh:message "Add the output." ] .

# An input or output of a workflow step, by name. It is part of its step's record.
form:FormalParameter a sh:NodeShape ;
    sh:targetClass bioschemas:FormalParameter ;
    rdfs:label "Input or output" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:description ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ; sh:datatype xsd:string ] .

# A page section: heading, HTML text and position. It is part of its page's record.
form:WebPageElement a sh:NodeShape ;
    sh:targetClass schema:WebPageElement ;
    rdfs:label "Section" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Heading" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:text ; sh:order 2 ; sh:name "Text" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:position ; sh:order 3 ; sh:name "Position" ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

# A publication's journal, with its ISSNs; it is part of the publication's record.
form:Periodical a sh:NodeShape ;
    sh:targetClass schema:Periodical ;
    rdfs:label "Journal" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path schema:issn ; sh:order 2 ; sh:name "ISSN" ; sh:datatype xsd:string ; sh:pattern "^[0-9]{4}-[0-9]{3}[0-9X]$" ] .

# A publication, at /publications/<DOI>, with the DOI's address in sameAs.
form:ScholarlyArticle a sh:NodeShape ;
    sh:targetClass schema:ScholarlyArticle ;
    rdfs:label "Publication" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:maxCount 1 ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:author ; sh:order 2 ; sh:name "Authors" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ] ;
    sh:property [ sh:path schema:datePublished ; sh:order 3 ; sh:name "Published" ; sh:maxCount 1 ;
        sh:or ( [ sh:datatype xsd:date ; rdfs:label "Date" ] [ sh:datatype xsd:gYearMonth ; rdfs:label "Month" ] [ sh:datatype xsd:gYear ; rdfs:label "Year" ] ) ;
        sh:description "A date, a month or a year, as precise as the publisher gives it." ] ;
    sh:property [ sh:path schema:isPartOf ; sh:order 4 ; sh:name "Journal" ; sh:maxCount 1 ;
        sh:class schema:Periodical ; sh:node form:Periodical ; sh:nodeKind sh:BlankNode ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 5 ; sh:name "DOI and other addresses" ; sh:minCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "DOI needed, starting with https://doi.org/10." ;
        sh:description "The DOI as a web address, the Wikidata item, and other addresses." ] .

# A page of the platform, with its text in sections; or a page elsewhere, such as a tool's guide, as part
# of the tool's record.
form:WebPage a sh:NodeShape ;
    sh:targetClass schema:WebPage ;
    rdfs:label "Page" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:description ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:url ; sh:order 3 ; sh:name "Address elsewhere" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:hasPart ; sh:order 4 ; sh:name "Sections" ; sh:class schema:WebPageElement ; sh:node form:WebPageElement ; sh:nodeKind sh:BlankNode ;
        sh:description "Sections of a platform page, each with a heading, an HTML text, a position and an anchor." ] .

# A video, such as a PeerTube one, shown in its player; it is part of the record that shows it.
form:VideoObject a sh:NodeShape ;
    sh:targetClass schema:VideoObject ;
    rdfs:label "Video" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:embedUrl ; sh:order 2 ; sh:name "Player" ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:message "The player's address needed." ;
        sh:description "The address of the video's player, such as https://video.edu.nl/videos/embed/<id>." ] .

# A dataset, at /data/<identifier>, based on a BioStudies study or a Zenodo record (schema:isBasedOn).
form:Dataset a sh:NodeShape ;
    sh:targetClass schema:Dataset ;
    rdfs:label "Dataset" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Title" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One title needed." ] ;
    sh:property [ sh:path schema:description ; sh:order 2 ; sh:name "Description" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] ;
    sh:property [ sh:path schema:creator ; sh:order 3 ; sh:name "Authors" ;
        sh:or ( [ sh:class schema:Person ; rdfs:label "Person" ] [ sh:class schema:Organization ; rdfs:label "Organisation" ] ) ] ;
    sh:property [ sh:path schema:datePublished ; sh:order 4 ; sh:name "Published" ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
    sh:property [ sh:path glossary:VHP0000152 ; sh:order 5 ; sh:name "Assessment steps" ;
        sh:severity sh:Warning ; sh:nodeKind sh:IRI ; sh:in ( glossary:VHP0000153 glossary:VHP0000154 glossary:VHP0000155 glossary:VHP0000156 glossary:VHP0000158 ) ;
        sh:message "Choose from the list; other values are not in the filters." ] ;
    sh:property [ sh:path glossary:VHP0000151 ; sh:order 6 ; sh:name "Case-study questions" ; sh:class schema:HowTo ] ;
    sh:property [ sh:path schema:isPartOf ; sh:order 6 ; sh:name "Case studies" ; sh:class bioschemas_draft:Study ;
        sh:description "Case studies the data was made for." ] ;
    sh:property [ sh:path schema:about ; sh:order 7 ; sh:name "Topics" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it." ;
        sh:description "What the data is about, such as the organism." ] ;
    sh:property [ sh:path schema:measurementMethod ; sh:order 8 ; sh:name "Methods" ; sh:class bioschemas_draft:LabProtocol ;
        sh:description "Methods the data was measured with." ] ;
    sh:property [ sh:path schema:measurementTechnique ; sh:order 9 ; sh:name "Assays" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a term, such as from BAO, or register it." ;
        sh:description "Assays the data was measured with, as terms of BAO or other ontologies." ] ;
    sh:property [ sh:path schema:citation ; sh:order 10 ; sh:name "Publications" ; sh:class schema:ScholarlyArticle ] ;
    sh:property [ sh:path schema:license ; sh:order 11 ; sh:name "License" ; sh:maxCount 1 ; sh:severity sh:Warning ;
        sh:class schema:DefinedTerm ; sh:pattern "^https://spdx\\.org/licenses/" ; form:publishedAs schema:CreativeWork ;
        sh:message "Choose an SPDX license; other values are kept." ] ;
    sh:property [ sh:path schema:isBasedOn ; sh:order 12 ; sh:name "Source record" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ;
        sh:description "The BioStudies or Zenodo record this one is made from, every night." ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 13 ; sh:name "DOI and other addresses" ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:keywords ; sh:order 14 ; sh:name "Keywords" ; sh:severity sh:Warning ; sh:class schema:DefinedTerm ;
        sh:message "Choose a vocabulary term, or register it; text is kept until then." ] .

# A vocabulary or ontology term, at its own address, with its label and vocabulary, so that records can
# be about it.
form:DefinedTerm a sh:NodeShape ;
    sh:targetClass schema:DefinedTerm ;
    rdfs:label "Term" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Label" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One label needed." ] ;
    sh:property [ sh:path schema:inDefinedTermSet ; sh:order 2 ; sh:name "Vocabulary" ; sh:minCount 1 ; sh:maxCount 1 ; sh:class schema:DefinedTermSet ;
        sh:message "One vocabulary needed." ] ;
    sh:property [ sh:path schema:termCode ; sh:order 3 ; sh:name "Code" ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path schema:alternateName ; sh:order 5 ; sh:name "Other names" ; sh:datatype xsd:string ;
        sh:description "Such as a short name." ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 6 ; sh:name "Other addresses" ;
        sh:or ( [ sh:class schema:DefinedTerm ; rdfs:label "Term" ] [ sh:nodeKind sh:IRI ; rdfs:label "Address" ] ) ;
        sh:description "The same term in another vocabulary, or another address, such as a license's text." ] ;
    sh:property [ sh:path schema:description ; sh:order 4 ; sh:name "Definition" ; sh:maxCount 1 ; dash:singleLine false ; sh:or ( form:PlainText form:HTMLText ) ] .

# A vocabulary or ontology, at /vocabularies/<name>; its terms name it (inDefinedTermSet), and their
# addresses may share a namespace.
form:DefinedTermSet a sh:NodeShape ;
    sh:targetClass schema:DefinedTermSet ;
    rdfs:label "Vocabulary" ;
    sh:property [ sh:path schema:name ; sh:order 1 ; sh:name "Name" ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:message "One name needed." ] ;
    sh:property [ sh:path void:uriSpace ; sh:order 2 ; sh:name "Namespace" ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^https?://" ;
        sh:message "One web address start, such as http://purl.obolibrary.org/obo/NCBITaxon_." ;
        sh:description "The start of its terms' addresses, when they share one." ] ;
    sh:property [ sh:path schema:url ; sh:order 3 ; sh:name "Home page" ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path schema:sameAs ; sh:order 4 ; sh:name "Same as" ; sh:nodeKind sh:IRI ;
        sh:description "Its own address elsewhere, such as its Wikidata item." ] ;
    sh:property [ sh:path schema:description ; sh:order 5 ; sh:name "Description" ; sh:maxCount 1 ; sh:datatype xsd:string ] .
