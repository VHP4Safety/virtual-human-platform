{
  "@context": {
    "schema": "https://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "bioschemastypes": "https://discovery.biothings.io/view/bioschemastypes/",
    "vhp4safety": "https://platform.vhp4safety.nl/profiles/"
  },
  "@graph": [
    {
      "@id": "vhp4safety:Grant",
      "@type": "rdfs:Class",
      "rdfs:label": "Grant",
      "rdfs:comment": "A grant that funds the VHP4Safety project or its partners, with its funder and amount. Version: 0.1-DRAFT.",
      "rdfs:subClassOf": {
        "@id": "schema:MonetaryGrant"
      },
      "$validation": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "title": "Name",
            "description": "One name needed.",
            "type": "string"
          },
          "identifier": {
            "title": "Grant number",
            "type": "string"
          },
          "alternateName": {
            "title": "Acronym",
            "type": "string"
          },
          "funder": {
            "title": "Funder",
            "description": "Add the funder.",
            "anyOf": [
              {
                "$ref": "#/definitions/organization"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/organization"
                }
              }
            ]
          },
          "amount": {
            "title": "Amount",
            "$ref": "#/definitions/monetaryamount"
          },
          "url": {
            "title": "Page",
            "description": "The page of the grant at the funder.",
            "type": "string",
            "format": "uri"
          },
          "description": {
            "title": "Description",
            "type": "string",
            "contentMediaType": "text/html"
          }
        },
        "required": [
          "name"
        ],
        "recommended": [
          "funder"
        ],
        "optional": [
          "identifier",
          "alternateName",
          "amount",
          "url",
          "description"
        ],
        "definitions": {
          "organization": {
            "@type": "schema:Organization",
            "type": "object"
          },
          "monetaryamount": {
            "@type": "schema:MonetaryAmount",
            "type": "object",
            "properties": {
              "value": {
                "title": "Value",
                "description": "One number needed.",
                "type": "number"
              },
              "currency": {
                "title": "Currency",
                "description": "A three-letter currency code, such as EUR.",
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              }
            },
            "required": [
              "value",
              "currency"
            ]
          }
        }
      }
    }
  ]
}
