@prefix dct: <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .

<https://platform.vhp4safety.nl/profiles/PBPKModel/0.1-DRAFT> a prof:Profile ;
    rdfs:label "PBPK model 0.1-DRAFT" ;
    rdfs:comment "A profile of the RO-Crate of a physiologically based kinetic (PBK/PBPK) model. Its main entity is a ComputationalWorkflow with the fields that ROBOT requires of a PBPK model, in the sections of ROBOT, in addition to the Bioschemas ComputationalWorkflow profile." ;
    prof:hasResource [ a prof:ResourceDescriptor ;
            dct:format <https://w3id.org/mediatype/text/turtle> ;
            prof:hasArtifact <https://platform.vhp4safety.nl/profiles/PBPKModel/0.1-DRAFT/PBPKModel.ttl> ;
            prof:hasRole role:validation ] ;
    prof:hasToken "vhp4safety-pbpkmodel-0.1-draft" ;
    prof:isProfileOf <https://w3id.org/ro/crate/1.2> .

