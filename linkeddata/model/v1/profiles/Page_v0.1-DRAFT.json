{
  "@context": {
    "schema": "https://schema.org/",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "bioschemastypes": "https://discovery.biothings.io/view/bioschemastypes/",
    "form": "https://platform.vhp4safety.nl/model/v1/form#",
    "vhp4safety": "https://platform.vhp4safety.nl/profiles/"
  },
  "@graph": [
    {
      "@id": "vhp4safety:Page",
      "@type": "rdfs:Class",
      "rdfs:label": "Page",
      "rdfs:comment": "A page of the VHP4Safety platform, such as an about page: its sections, and the records that its sections present. Version: 0.1-DRAFT.",
      "rdfs:subClassOf": {
        "@id": "schema:WebPage"
      },
      "$validation": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "name": {
            "title": "Title",
            "type": "string"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "url": {
            "title": "Address elsewhere",
            "type": "string",
            "format": "uri"
          },
          "about": {
            "title": "Terms explained",
            "description": "A term with kinds that are explained on the page, such as Process Flow Step.",
            "anyOf": [
              {
                "$ref": "#/definitions/definedterm"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/definedterm"
                }
              }
            ]
          },
          "hasPart": {
            "title": "Sections",
            "description": "Sections of a platform page, each with a heading, a text and a position. The sections of a section are its items.",
            "anyOf": [
              {
                "$ref": "#/definitions/webpageelement"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/webpageelement"
                }
              }
            ]
          },
          "mainEntity": {
            "title": "About",
            "description": "Its description, videos, figures, research lines, grants and partners are shown, and the publications of its grants.",
            "$ref": "#/definitions/organization"
          }
        },
        "required": [],
        "optional": [
          "name",
          "description",
          "url",
          "about",
          "hasPart",
          "mainEntity"
        ],
        "definitions": {
          "definedterm": {
            "@type": "schema:DefinedTerm",
            "type": "object"
          },
          "webpageelement": {
            "@type": "schema:WebPageElement",
            "type": "object",
            "properties": {
              "name": {
                "title": "Heading",
                "type": "string"
              },
              "text": {
                "title": "Text",
                "type": "string",
                "contentMediaType": "text/html"
              },
              "position": {
                "title": "Position",
                "type": "integer"
              },
              "image": {
                "title": "Figures",
                "description": "Shown after the text.",
                "anyOf": [
                  {
                    "$ref": "#/definitions/imageobject"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/imageobject"
                    }
                  }
                ]
              },
              "video": {
                "title": "Videos",
                "anyOf": [
                  {
                    "$ref": "#/definitions/videoobject"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/videoobject"
                    }
                  }
                ]
              },
              "creativeWorkStatus": {
                "title": "Status",
                "description": "Empty: the section is shown. hidden: the section is kept in the data, but not shown on the page.",
                "type": "string",
                "enum": [
                  "hidden"
                ]
              },
              "hasPart": {
                "title": "Sections",
                "description": "Its own sections, shown as its items.",
                "anyOf": [
                  {
                    "$ref": "#/definitions/webpageelement"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/definitions/webpageelement"
                    }
                  }
                ]
              },
              "about": {
                "title": "Presents",
                "description": "The record that is presented in the section, with the shown fields. Or, for a grant without shown fields, the records that name the grant, such as its publications.",
                "anyOf": [
                  {
                    "$ref": "#/definitions/monetarygrant"
                  },
                  {
                    "$ref": "#/definitions/organization"
                  },
                  {
                    "$ref": "#/definitions/learningresource"
                  }
                ]
              },
              "url": {
                "title": "Address",
                "description": "Where the section is read, such as a section of a tutorial on the documentation site.",
                "type": "string",
                "format": "uri"
              },
              "shows": {
                "title": "Shows",
                "description": "The fields of the presented record that are shown in the section, such as its description or its research lines.",
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri",
                    "enum": [
                      "https://schema.org/description",
                      "https://schema.org/text",
                      "https://schema.org/image",
                      "https://schema.org/video",
                      "https://schema.org/subjectOf",
                      "https://schema.org/subOrganization",
                      "https://schema.org/member",
                      "https://schema.org/funding",
                      "https://schema.org/funder",
                      "https://schema.org/amount",
                      "https://schema.org/identifier"
                    ]
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uri",
                      "enum": [
                        "https://schema.org/description",
                        "https://schema.org/text",
                        "https://schema.org/image",
                        "https://schema.org/video",
                        "https://schema.org/subjectOf",
                        "https://schema.org/subOrganization",
                        "https://schema.org/member",
                        "https://schema.org/funding",
                        "https://schema.org/funder",
                        "https://schema.org/amount",
                        "https://schema.org/identifier"
                      ]
                    }
                  }
                ]
              }
            }
          },
          "imageobject": {
            "@type": "schema:ImageObject",
            "type": "object",
            "properties": {
              "contentUrl": {
                "title": "Image",
                "description": "One image address needed.",
                "type": "string",
                "format": "uri"
              },
              "caption": {
                "title": "Caption",
                "description": "Also read out in place of the image.",
                "type": "string"
              }
            },
            "required": [
              "contentUrl"
            ]
          },
          "videoobject": {
            "@type": "schema:VideoObject",
            "type": "object",
            "properties": {
              "name": {
                "title": "Title",
                "type": "string"
              },
              "embedUrl": {
                "title": "Player",
                "description": "The address of the player of the video, such as https://video.edu.nl/videos/embed/<id>.",
                "type": "string",
                "format": "uri"
              },
              "thumbnailUrl": {
                "title": "Thumbnail",
                "type": "string",
                "format": "uri"
              },
              "duration": {
                "title": "Duration",
                "description": "An ISO 8601 duration, such as PT5M38S.",
                "type": "string",
                "pattern": "^P"
              }
            },
            "required": [
              "embedUrl"
            ]
          },
          "monetarygrant": {
            "@type": "schema:MonetaryGrant",
            "type": "object"
          },
          "organization": {
            "@type": "schema:Organization",
            "type": "object"
          },
          "learningresource": {
            "@type": "schema:LearningResource",
            "type": "object"
          }
        }
      }
    },
    {
      "@id": "form:shows",
      "@type": "rdf:Property",
      "rdfs:label": "shows",
      "rdfs:comment": "Shows",
      "schema:domainIncludes": {
        "@id": "schema:WebPageElement"
      },
      "schema:rangeIncludes": {
        "@id": "rdf:Property"
      }
    }
  ]
}
