@prefix dct: <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .

<https://platform.vhp4safety.nl/profiles/Page/0.1-DRAFT> a prof:Profile ;
    rdfs:label "Platform page 0.1-DRAFT" ;
    rdfs:comment "A profile of the pages of the VHP4Safety platform, such as an about page: its sections, and the records that its sections present." ;
    prof:hasResource [ a prof:ResourceDescriptor ;
            dct:format <https://w3id.org/mediatype/text/turtle> ;
            prof:hasArtifact <https://platform.vhp4safety.nl/profiles/Page/0.1-DRAFT/Page.ttl> ;
            prof:hasRole role:validation ] ;
    prof:hasToken "vhp4safety-page-0.1-draft" ;
    prof:isProfileOf <https://schema.org/> .

