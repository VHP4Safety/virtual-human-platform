@prefix dct: <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .

<https://platform.vhp4safety.nl/profiles/Term/0.1-DRAFT> a prof:Profile ;
    rdfs:label "Term 0.1-DRAFT" ;
    rdfs:comment "A profile of the vocabulary terms of the VHP4Safety platform: the people who added or curated a term, and the table of the VHP4Safety glossary that a draft term goes to." ;
    prof:hasResource [ a prof:ResourceDescriptor ;
            dct:format <https://w3id.org/mediatype/text/turtle> ;
            prof:hasArtifact <https://platform.vhp4safety.nl/profiles/Term/0.1-DRAFT/Term.ttl> ;
            prof:hasRole role:validation ] ;
    prof:hasToken "vhp4safety-term-0.1-draft" ;
    prof:isProfileOf <https://schema.org/> .
