@prefix dct: <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .

<https://platform.vhp4safety.nl/profiles/Grant/0.1-DRAFT> a prof:Profile ;
    rdfs:label "Grant 0.1-DRAFT" ;
    rdfs:comment "A profile of the grants that fund the VHP4Safety project or its partners, with their funder and amount." ;
    prof:hasResource [ a prof:ResourceDescriptor ;
            dct:format <https://w3id.org/mediatype/text/turtle> ;
            prof:hasArtifact <https://platform.vhp4safety.nl/profiles/Grant/0.1-DRAFT/Grant.ttl> ;
            prof:hasRole role:validation ] ;
    prof:hasToken "vhp4safety-grant-0.1-draft" ;
    prof:isProfileOf <https://schema.org/> .

