# Normalize all text files to LF on checkout and commit.
# This prevents CRLF line-ending noise from files uploaded via the GitHub web UI.
* text=auto eol=lf

# Explicitly enforce LF for the most sensitive file types in this project
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
static/js/j2s/**/*.js binary
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.sh   text eol=lf

# Treat compiled/binary assets as binary (no line-ending conversion)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.z    binary

# Generated and pinned files of the linked data model, folded in GitHub diffs
linkeddata/model/v1/schema.json linguist-generated=true
database/v1/tables.sql linguist-generated=true
linkeddata/model/v1/vocabularies/** linguist-vendored=true
